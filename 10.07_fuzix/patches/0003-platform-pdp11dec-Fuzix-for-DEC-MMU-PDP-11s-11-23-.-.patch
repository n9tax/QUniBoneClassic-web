+; SIMH pdp11 configuration for Fuzix RL02 boot
+;
+; Run from this directory after ./build_fuzix_disk.sh:
+;   pdp11 fuzix_simh.ini
+; then connect the console:
+;   telnet localhost 12345
+
+set cpu 11/40
+set cpu 128k
+; instruction history aids crash post-mortems (show cpu history)
+;set cpu history=500
+
+set rl0 rl02
+attach rl0 fuzix_rl02.dsk
+
+set console telnet=12345
+set console telnet=buffered
+
+; Second terminal (/dev/tty2): SIMH's DL11 multiplexer defaults to
+; the same CSR base (176500) the platform uses for minor 2.
+;set dli enabled
+;set dli lines=1
+;attach dli 12346
+
+boot rl0
diff --git a/Kernel/platform/platform-pdp11dec/init.c b/Kernel/platform/platform-pdp11dec/init.c
new file mode 100644
index 000000000..e537623ac
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/init.c
@@ -0,0 +1,102 @@
+/*
+ * Minimal /init for Fuzix PDP-11
+ *
+ * Spawns a shell on each serial terminal (tty1 = console DL11,
+ * tty2 = second DL11 at 0176500) and respawns whichever exits.
+ *
+ * No stdio, no inittab, no login — just get to shell prompts.
+ */
+
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/wait.h>
+#include <syscalls.h>	/* setpgrp */
+
+static const char *sh_argv[] = { "-sh", (void *)0 };
+static const char *sh_envp[] = { "PATH=/bin", "HOME=/", (void *)0 };
+static const char msg[] = "\r\n[init: shell exited, restarting]\r\n";
+
+static const char *ttydev[] = { "/dev/tty1", "/dev/tty2" };
+#define NTTY 2
+static int ttypid[NTTY];
+
+static void spawn(int t)
+{
+	int pid = fork();
+	if (pid == 0) {
+		/* child — become a session leader FIRST, then attach to
+		   this terminal and exec the shell.
+		   setpgrp() gives us our own process group and clears the
+		   controlling tty we inherited from init.  Without it the
+		   child keeps init's p_tty, so tty_open()'s "process has
+		   no ctty yet" guard fails and the terminal never gets a
+		   pgrp: sgrpsig() ignores pgrp 0, which made ^C on tty2 a
+		   silent no-op.  (tty1 appeared to work back then only
+		   because init's open of /dev/console had put ITS pgrp on
+		   the tty and the shells still inherited it — this very
+		   setpgrp() ended that accident and exposed the console
+		   swallow; see the O_NOCTTY note in main().)  With both
+		   fixes, each terminal carries its own foreground group,
+		   so ^C reaches that terminal's job and nothing else. */
+		setpgrp();
+		close(0);
+		close(1);
+		close(2);
+		open(ttydev[t], O_RDWR);	/* fd 0 = stdin */
+		dup(0);				/* fd 1 = stdout */
+		dup(0);				/* fd 2 = stderr */
+		execve("/bin/sh", (char **)sh_argv, (char **)sh_envp);
+		/* if exec fails, try the small shell */
+		sh_argv[0] = "-ssh";
+		execve("/bin/ssh", (char **)sh_argv, (char **)sh_envp);
+		write(1, "init: no shell\r\n", 16);
+		_exit(1);
+	}
+	ttypid[t] = pid;	/* -1 on fork failure: retried next wait */
+}
+
+int main(int argc, char **argv)
+{
+	int t, pid, status;
+
+	/* Open console for init's own fds (init starts with none).
+	   O_NOCTTY is load-bearing: without it this open claims the
+	   console as init's controlling tty and parks t_pgrp on
+	   init's process group.  tty_post() only assigns a pgrp to a
+	   tty whose pgrp is still 0, so the tty1 shell's own open
+	   could never take it back — every console ^C then signalled
+	   only init and the shell's job never saw SIGINT (silicon
+	   sigtty_probe 2026-07-23: tty2 ^C green, console ^C dead).
+	   Init only ever writes here; it has no business owning the
+	   terminal. */
+	close(0);
+	close(1);
+	close(2);
+	open("/dev/console", O_RDWR | O_NOCTTY);	/* fd 0 = stdin */
+	dup(0);				/* fd 1 = stdout */
+	dup(0);				/* fd 2 = stderr */
+
+	/* A terminal that cannot be opened (no second DL11) is
+	   marked -2 and never gets a shell. */
+	for (t = 0; t < NTTY; t++) {
+		int fd = open(ttydev[t], O_RDWR | O_NOCTTY);
+		ttypid[t] = fd < 0 ? -2 : -1;
+		if (fd >= 0)
+			close(fd);
+	}
+
+	for (;;) {
+		for (t = 0; t < NTTY; t++)
+			if (ttypid[t] == -1)
+				spawn(t);
+		pid = wait(&status);
+		if (pid < 0)
+			continue;
+		for (t = 0; t < NTTY; t++)
+			if (ttypid[t] == pid) {
+				ttypid[t] = -1;
+				if (t == 0)
+					write(1, msg, sizeof(msg) - 1);
+			}
+	}
+}
diff --git a/Kernel/platform/platform-pdp11dec/libc.c b/Kernel/platform/platform-pdp11dec/libc.c
new file mode 100644
index 000000000..34c1d84d4
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/libc.c
@@ -0,0 +1,40 @@
+#include "kernel.h"
+
+void *memcpy(void *d, const void *s, size_t sz)
+{
+  unsigned char *dp = d;
+  const unsigned char *sp = s;
+  while(sz--)
+    *dp++=*sp++;
+  return d;
+}
+
+void *memset(void *d, int c, size_t sz)
+{
+  unsigned char *p = d;
+  while(sz--)
+    *p++ = c;
+  return d;
+}
+
+size_t strlen(const char *p)
+{
+  const char *e = p;
+  while(*e++);
+  return e-p-1;
+}
+
+int memcmp(const void *a, const void *b, size_t n)
+{
+  const uint8_t *ap = a;
+  const uint8_t *bp = b;
+  while(n--) {
+    if (*ap < *bp)
+      return -1;
+    if (*ap != *bp)
+      return 1;
+    ap++;
+    bp++;
+  }
+  return 0;
+}
diff --git a/Kernel/platform/platform-pdp11dec/main.c b/Kernel/platform/platform-pdp11dec/main.c
new file mode 100644
index 000000000..1bf9d711d
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/main.c
@@ -0,0 +1,172 @@
+#include <kernel.h>
+#include <timer.h>
+#include <kdata.h>
+#include <printf.h>
+#include <devtty.h>
+#include <buddy.h>
+
+void plt_idle(void)
+{
+	/* The idle loop can be reached at high IPL (e.g. preemption
+	   from the clock ISR); WAIT with interrupts masked never
+	   wakes.  Drop to priority 0 before waiting. */
+	__asm("bic $0340,*$0177776");
+	__asm("wait");
+}
+
+void do_beep(void)
+{
+}
+
+/* map_init is in pdp11.S */
+
+/* bankfixed pagemap_prepare sizes size-less binaries from ramtop */
+uaddr_t ramtop = PROGTOP;
+uint8_t need_resched;
+
+/*
+ * Memory: user banks of BANK_CLICKS from BANK0_CLICK up, as many as
+ * fit below the top of memory (see config.h).  bank_click[n] is the
+ * physical base of bank n in 64 byte clicks; bank 0 is "swapped".
+ * What is left above the last bank is for the Ethernet buffers.
+ */
+uint16_t bank_click[MAX_MAPS + 1];
+uint16_t mem_top_click;		/* first missing click */
+uint16_t free_click;		/* first click above the banks */
+
+extern uint16_t phys_present(uint16_t click);
+
+void pagemap_init(void)
+{
+	uint16_t c;
+	uint8_t n;
+
+	/* Find the top of memory in 8 KB steps; the I/O page at
+	   0x3E000 ends it on an 18 bit machine. */
+	for (c = 0x300; c < 0xF80; c += 0x80)
+		if (!phys_present(c))
+			break;
+	mem_top_click = c;
+	ramsize = c >> 4;
+	for (n = 1; n <= MAX_MAPS; n++) {
+		c = BANK0_CLICK + (n - 1) * BANK_CLICKS;
+		if (c + BANK_CLICKS > mem_top_click)
+			break;
+		bank_click[n] = c;
+		pagemap_add(n);
+	}
+	free_click = BANK0_CLICK + (n - 1) * BANK_CLICKS;
+	procmem = (n - 1) * (BANK_CLICKS >> 4);
+}
+
+uint8_t plt_param(char *p)
+{
+	return 0;
+}
+
+void plt_discard(void)
+{
+}
+
+void memzero(void *p, usize_t len)
+{
+	memset(p, 0, len);
+}
+
+/* User-mode MMU abort (from trap_mmu in pdp11.S): signal the
+   process and clear the latched SR0 error flags so translation
+   carries on.  chksigs applies the default disposition — for an
+   uncaught SIGSEGV that is doexit, which never returns here.  A
+   CAUGHT SIGSEGV is staged in u_cursig and delivered by trap_mmu's
+   return hook (otherwise the process would refault forever). */
+void plt_usermmu(void)
+{
+	*(volatile uint16_t *)0177572 = 1;	/* SR0: enable, clear errors */
+	ssig(udata.u_ptab, SIGSEGV);
+	chksigs();
+}
+
+/* Other traps in user mode (pdp11.S trap_maybe_user), by vector */
+void plt_usertrap(uint16_t vec)
+{
+	uint8_t sig;
+	switch (vec) {
+	case 004: sig = SIGBUS; break;
+	case 010: sig = SIGILL; break;
+	case 014: sig = SIGTRAP; break;
+	case 020: sig = SIGIOT; break;
+	default:  sig = SIGSYS; break;	/* EMT */
+	}
+	ssig(udata.u_ptab, sig);
+	chksigs();
+}
+
+/*
+ * Caught-signal delivery — the kernel half of the trampoline
+ * (task #13, 2026jul22_sigtramp.md).
+ *
+ * chksigs() stages a caught signal in udata.u_cursig; the asm
+ * return-to-user hooks in pdp11.S call this when it is nonzero.
+ * We build a six-word frame on the user stack and enter the
+ * handler directly: it sees a textbook C call with the signal
+ * number at 2(sp) and a return address pointing at the crt0
+ * __sigreturn stub, whose address the binary publishes at
+ * u_codebase+16 (the exec.h a_sigvec slot).  The stub drops the
+ * argument, restores r0/r1 and rtt's back into the interrupted
+ * code — bit-exact, condition codes included.  r2-r5 need no
+ * saving: gcc-pdp11 treats them as callee-saved, so any
+ * ABI-compliant handler preserves them itself.
+ *
+ * upc/upsw are the interrupted user PC/PSW from the trap frame;
+ * ur0/ur1 are the r0/r1 the interrupted code will see on resume —
+ * at syscall exit that is u_retval/u_error, so an interrupted
+ * read()'s -1/EINTR survives the handler.
+ *
+ * Returns the handler address (the caller redirects the frame PC)
+ * or 0 if there is nothing to run after all.  Kill paths never
+ * return.
+ */
+extern uint16_t get_usp(void);
+extern void set_usp(uint16_t);
+
+uint16_t sig_deliver(uint16_t upc, uint16_t upsw, uint16_t ur0, uint16_t ur1)
+{
+	uint_fast8_t sig = udata.u_cursig;
+	int (**svec)(int) = &udata.u_sigvec[sig];
+	int (*vec)(int) = *svec;
+	uint16_t tramp, usp;
+	uint16_t frame[6];
+
+	udata.u_cursig = 0;
+	if (!sig)
+		return 0;
+	*svec = SIG_DFL;	/* V7 semantics: reset before entry */
+	if (vec == SIG_IGN)	/* disposition raced away: nothing to do */
+		return 0;
+	if (vec == SIG_DFL)
+		doexit(dump_core(sig));
+
+	/* An old entry-16 binary has __start2 CODE at codebase+16
+	   instead of the stub pointer; its first word (a jsr opcode)
+	   sits far below PROGBASE, so the range guard turns a caught
+	   signal into a clean default-action death rather than a
+	   jump into hyperspace. */
+	tramp = ugetw((void *)(udata.u_codebase + 16));
+	if (tramp < PROGBASE || tramp >= (uint16_t)udata.u_top)
+		doexit(dump_core(sig));
+
+	frame[0] = tramp;		/* handler's return address */
+	frame[1] = sig;			/* handler's argument */
+	frame[2] = ur1;
+	frame[3] = ur0;
+	frame[4] = upc;			/* rtt pops these two */
+	frame[5] = upsw;
+	usp = get_usp() - 12;
+	/* uput windows through KIPAR5 and validates the range; a
+	   trashed user SP fails validation and the process dies here
+	   rather than scribbling on the other bank. */
+	if (uput(frame, (void *)usp, 12))
+		doexit(dump_core(SIGKILL));
+	set_usp(usp);
+	return (uint16_t)(arg_t)vec;
+}
diff --git a/Kernel/platform/platform-pdp11dec/make_fuzix_bin.py b/Kernel/platform/platform-pdp11dec/make_fuzix_bin.py
new file mode 100644
index 000000000..725571260
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/make_fuzix_bin.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""
+Convert a PDP-11 binary to Fuzix exec format.
+
+Input: a flat binary produced by objcopy -O binary, linked at PROGBASE.
+       The first 16 bytes are the crt0 FZX1 header (will be replaced).
+Output: Fuzix exec binary with 16-byte struct exec header replacing crt0 header.
+
+The kernel loads the binary starting at progload (= a_base << 8):
+  - Reads struct exec header (first 16 bytes), computes bin_size
+  - Overwrites bytes 0-15 at progload with sys_stubs
+  - Loads remaining bytes at progload+16: the a_sigvec word
+    (crt0's __sigreturn address, read at caught-signal delivery)
+    then code (crt0 __start2 entry at +18)
+  - doexec(progload + a_entry) starts execution
+
+Usage: make_fuzix_bin.py <input.bin> <output.fuz> [progbase_hex]
+"""
+import sys
+import struct
+
+if len(sys.argv) < 3:
+    print(f"Usage: {sys.argv[0]} <input.bin> <output.fuz> [progbase_hex]")
+    sys.exit(1)
+
+input_path = sys.argv[1]
+output_path = sys.argv[2]
+progbase = int(sys.argv[3], 16) if len(sys.argv) > 3 else 0xA000
+
+with open(input_path, 'rb') as f:
+    code = f.read()
+
+if len(code) < 16:
+    print(f"ERROR: Input too small ({len(code)} bytes, need at least 16)")
+    sys.exit(1)
+
+# The flat binary includes the 16-byte crt0 header at offset 0.
+# Replace it with the proper Fuzix struct exec header.
+# Total file size = len(code) (header + body, same size as input).
+total_size = len(code)
+
+# a_text = total file size (includes the 16-byte header).
+# The kernel does: bin_size = a_text + a_data - sizeof(struct exec)
+# So bin_size = total_size - 16 = the code bytes after the header.
+a_text = total_size
+
+# Minimum 64 bytes total (kernel rejects bin_size < 64)
+if a_text < 80:  # 80 because bin_size = a_text - 16 >= 64
+    pad = 80 - a_text
+    code += b'\x00' * pad
+    a_text = 80
+    total_size = len(code)
+    print(f"  Padded {pad} bytes to meet 64-byte minimum")
+
+# struct exec: magic(2), cpu(1), cpufeat(1), base(1), hints(1),
+#              text(2), data(2), bss(2), entry(1), size(1), stack(1), zp(1)
+header = struct.pack('<HBBBBHHHBBBB',
+    0x80A8,         # a_magic
+    7,              # a_cpu = A_PDP11
+    0,              # a_cpufeat
+    progbase >> 8,  # a_base (page number)
+    0,              # a_hints
+    a_text,         # a_text (total file size including header)
+    0,              # a_data
+    0,              # a_bss
+    18,             # a_entry: past header (16) AND the a_sigvec word
+                    # at offset 16 — crt0 publishes __sigreturn there
+                    # for caught-signal delivery (task #13)
+    0,              # a_size (all memory)
+    0,              # a_stack
+    0,              # a_zp
+)
+
+assert len(header) == 16
+
+with open(output_path, 'wb') as f:
+    f.write(header)
+    f.write(code[16:])  # skip crt0 header, replace with exec header
+
+print(f"Created {output_path}: {total_size - 16} bytes code, {total_size} bytes total")
+print(f"  PROGBASE=0x{progbase:04X}, a_text={a_text} (incl header), entry=PROGBASE+18 (sigvec word at +16)")
diff --git a/Kernel/platform/platform-pdp11dec/pdp11.S b/Kernel/platform/platform-pdp11dec/pdp11.S
new file mode 100644
index 000000000..00b7b13f1
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/pdp11.S
@@ -0,0 +1,623 @@
+#include "../../cpu-pdp11/kernel-pdp11.def"
+
+	.text
+	.globl _program_vectors
+	.globl _plt_monitor
+	.globl _plt_reboot
+	.globl outchar
+	.globl init_hardware
+	.globl init_early
+	.globl _map_init
+
+init_early:
+	rts pc
+
+_plt_monitor:
+_plt_reboot:
+	bis $0340,*$0177776	/* IRQ off */
+	jmp _plt_reboot
+
+	.bss
+	.even
+	.globl _udata
+
+_udata:
+	.= . + 512
+
+	.text
+
+/*
+ *	KL11 and equivalents
+ */
+
+outchar:
+	bitb $0x80,0177564		/* test bit 7 of TCSR (tx ready) */
+	beq outchar
+	mov r0,0177566
+	rts pc
+
+init_hardware:
+	/* KW11-L: enable interrupt, 60Hz line clock, vector 0100, BR6.
+	   An 11/23 without a KW11-L board has no register at 177546:
+	   its clock interrupt comes from the backplane (BEVENT) and
+	   cannot be switched off.  Probe, and remember the answer. */
+	mov *$4,-(sp)
+	mov *$6,-(sp)
+	mov $kw_nx,*$4
+	mov $0340,*$6
+	mov $1,_kw11_present
+	mov $0x40,*$0177546	/* bit 6 = interrupt enable */
+	mov (sp)+,*$6
+	mov (sp)+,*$4
+	/* DL11: polling mode (RX interrupt disabled until vectors ready) */
+	clr 0177560
+	rts pc
+
+kw_nx:
+	clr _kw11_present
+	rti
+
+	.globl _kw11_present
+	.data
+_kw11_present:	.word 0
+	.text
+
+/*
+ * map_init — set up the MMU (see config.h for the memory map).
+ *
+ * Kernel map (64KB virtual):
+ *   Page 0-5: 0x0000-0xBFFF  kernel code and data (identity map)
+ *   Page 6:   0xC000-0xDFFF  movable window (KIPAR6)
+ *   Page 7:   0xE000-0xFFFF  I/O page -> physical 0x3E000-0x3FFFF
+ *
+ * PAR value = physical_base / 64.  PDR 077406 = full 8 KB page, r/w.
+ * The user PARs are per process (program_user_map).
+ *
+ * MMU registers (I/O page addresses):
+ *   KIPDR0-7: 172300-172316    KIPAR0-7: 172340-172356
+ *   UIPDR0-7: 177600-177616    UIPAR0-7: 177640-177656
+ *   SR0:      177572
+ */
+_map_init:
+	/* ---- Kernel PARs (identity map) ---- */
+	clr 0172340			/* KIPAR0 = 0 (phys 0x0000) */
+	mov $0200,0172342		/* KIPAR1 = 128 (phys 0x2000) */
+	mov $0400,0172344		/* KIPAR2 = 256 (phys 0x4000) */
+	mov $0600,0172346		/* KIPAR3 = 384 (phys 0x6000) */
+	mov $01000,0172350		/* KIPAR4 = 512 (phys 0x8000) */
+	mov $01200,0172352		/* KIPAR5 = 640 (phys 0xA000) */
+	mov $01400,0172354		/* KIPAR6 = 768 (phys 0xC000) */
+	mov $07600,0172356		/* KIPAR7 = 3968 (phys 0x3E000 I/O page) */
+
+	/* ---- Kernel PDRs (full 8KB pages, read/write) ---- */
+	mov $077406,0172300		/* KIPDR0 = PLF=7F, ACF=6 (r/w) */
+	mov $077406,0172302		/* KIPDR1 */
+	mov $077406,0172304		/* KIPDR2 */
+	mov $077406,0172306		/* KIPDR3 */
+	mov $077406,0172310		/* KIPDR4 */
+	mov $077406,0172312		/* KIPDR5 */
+	mov $077406,0172314		/* KIPDR6 */
+	mov $077406,0172316		/* KIPDR7 */
+
+	/* ---- User PARs ----
+	 * Campaign B: the user map is PER-PROCESS.  VA 0x2000-0xCDFF
+	 * (43.5K) maps to the process's bank — bank 1 user area at
+	 * phys 0xA200, bank 2 at 0x15200 (offset 0x200 skips the
+	 * in-bank udata stash).  program_user_map (below) writes
+	 * UIPAR1-6 from udata.u_page at every switchin and doexec;
+	 * here they start clear (nothing user-mode runs before the
+	 * first doexec programs them). */
+	clr 0177640			/* UIPAR0 (NULL guard, no access) */
+	clr 0177642			/* UIPAR1-6: per-process, see */
+	clr 0177644			/*   program_user_map */
+	clr 0177646
+	clr 0177650
+	clr 0177652
+	clr 0177654
+	/* Page 7: no user I/O access */
+	clr 0177656			/* UIPAR7 */
+
+	/* ---- User PDRs ----
+	 * Constant for the slot geometry — only the PARs move between
+	 * banks.  Page 6 is length-limited to 56 blocks (VA 0xC000-
+	 * 0xCDFF): PLF=55 -> PDR 033406.  A user access above 0xCDFF
+	 * aborts on page length — that is the hardware wall between
+	 * the two resident banks. */
+	clr 0177600			/* UIPDR0 no access = NULL guard */
+	mov $077406,0177602		/* UIPDR1 rw, full 8K */
+	mov $077406,0177604		/* UIPDR2 rw */
+	mov $077406,0177606		/* UIPDR3 rw */
+	mov $077406,0177610		/* UIPDR4 rw */
+	mov $077406,0177612		/* UIPDR5 rw */
+	mov $033406,0177614		/* UIPDR6 rw, PLF=55 (43.5K top) */
+	/* Page 7: no access */
+	clr 0177616			/* UIPDR7 */
+
+	/* ---- Enable MMU ---- */
+	mov $1,0177572			/* SR0 bit 0 = enable */
+
+	rts pc
+
+/*
+ * program_user_map — write UIPAR1-6 for the current process's bank.
+ *
+ * VA 0x2000 is the bank base + 0x200 (above the udata stash):
+ * UIPAR n = bank_click[u_page] + 010 + (n-1)*0200.  Reads u_page
+ * every time (generic code changes it).  Clobbers r0.
+ */
+	.globl _program_user_map
+_program_user_map:
+	mov _udata+U_DATA__U_PAGE,r0
+	mov r0,_umap_page
+	asl r0
+	mov _bank_click(r0),r0
+	add $010,r0
+	mov r0,*$0177642	/* UIPAR1 */
+	add $0200,r0
+	mov r0,*$0177644	/* UIPAR2 */
+	add $0200,r0
+	mov r0,*$0177646	/* UIPAR3 */
+	add $0200,r0
+	mov r0,*$0177650	/* UIPAR4 */
+	add $0200,r0
+	mov r0,*$0177652	/* UIPAR5 */
+	add $0200,r0
+	mov r0,*$0177654	/* UIPAR6 */
+	rts pc
+
+/*
+ * program_vectors - write trap and interrupt vectors
+ *
+ * PDP-11 vector format: 2 words per vector
+ *   word 0 = new PC (handler address)
+ *   word 1 = new PSW (priority level)
+ *
+ * Called from the kernel during init. On entry, IRQs are disabled
+ * (PSW priority 7), so it's safe to write the vector table.
+ */
+_program_vectors:
+	/* Bus error / timeout — vector 004 */
+	mov $trap_bus, *$4
+	mov $0340, *$6
+
+	/* Illegal and reserved instruction — vector 010 */
+	mov $trap_ill, *$010
+	mov $0340, *$012
+
+	/* BPT — vector 014 */
+	mov $trap_bpt, *$014
+	mov $0340, *$016
+
+	/* IOT — vector 020 */
+	mov $trap_iot, *$020
+	mov $0340, *$022
+
+	/* Power fail — vector 024 */
+	mov $trap_pwr, *$024
+	mov $0340, *$026
+
+	/* EMT — vector 030 */
+	mov $trap_emt, *$030
+	mov $0340, *$032
+
+	/* TRAP — vector 034 — syscall entry */
+	mov $trap_syscall, *$034
+	mov $0340, *$036
+
+	/* KW11-L line clock — vector 0100, BR6 */
+	mov $interrupt_clock, *$0100
+	mov $0300, *$0102	/* PSW priority 6 */
+
+	/* RL11 — vector 0160 (not used, we poll, but catch stray) */
+	mov $interrupt_stray, *$0160
+	mov $0340, *$0162
+
+	/* MMU abort — vector 0250 */
+	mov $trap_mmu, *$0250
+	mov $0340, *$0252
+
+	/* DL11 console RX — vector 060, BR4.  PSW pri 4 so the
+	   KW11-L (BR6) can still nest during RX processing. */
+	mov $interrupt_tty, *$060
+	mov $0200, *$062
+
+	/* DL11 console TX — vector 064 (IE never set, catch stray) */
+	mov $interrupt_stray, *$064
+	mov $0200, *$066
+
+	/* DL11 tty2 RX — vector 0300, BR4 */
+	mov $interrupt_tty, *$0300
+	mov $0200, *$0302
+
+	/* DL11 tty2 TX — vector 0304 (IE never set, catch stray) */
+	mov $interrupt_stray, *$0304
+	mov $0200, *$0306
+
+	/* Vectors are live: enable both DL11 receiver interrupts.
+	   We are still at PSW pri 7 here, so nothing fires until the
+	   kernel drops priority. */
+	mov $0x40,0177560	/* console RCSR bit 6 = IE */
+
+	/* The second DL11 is optional: probe it with the bus error
+	   vector pointing at probe_nx, which clears _tty2_present. */
+	mov $probe_nx,*$4
+	mov $1,_tty2_present
+	mov $0x40,*$0176500	/* tty2 RCSR bit 6 = IE */
+	mov $trap_bus,*$4
+
+	rts pc
+
+probe_nx:
+	clr _tty2_present
+	rti
+
+	.globl _tty2_present
+	.globl _umap_page
+	.data
+_tty2_present:	.word 0
+_umap_page:	.word 0		/* bank the user map was loaded for */
+	.text
+
+/*
+ * Interrupt entry: KW11-L line clock (vector 0100)
+ *
+ * Hardware pushes PSW and PC. We save remaining registers,
+ * call plt_interrupt (C), restore and RTI.
+ */
+interrupt_clock:
+	mov r0,-(sp)
+	mov r1,-(sp)
+	mov r2,-(sp)
+	mov r3,-(sp)
+	mov r4,-(sp)
+	mov r5,-(sp)
+	incb _udata+U_DATA__U_ININTERRUPT
+	jsr pc,_plt_interrupt
+	decb _udata+U_DATA__U_ININTERRUPT
+
+	/* Preempt + spinner-signal hook (task #12).  Runs with the
+	   registers STILL SAVED (frame: r5..r0 at 0..10(sp), PC at
+	   12(sp), PSW at 14(sp)) so the signal-only leg can call C.
+	   Only user-mode returns are eligible: kernel returns cover
+	   the EIS emulator, syscall bodies and dofork's copy — none
+	   may be split. */
+	bit $0140000,14(sp)	/* returning to user mode? */
+	beq 8f
+	tstb _inswap		/* belt: never during swap I/O */
+	bne 8f
+	tstb _need_resched
+	bne 7f
+
+	/* No reschedule due — but a signal may be pending for the
+	   CURRENT process with nothing else runnable (probe run 1's
+	   Q4: need_resched only sets on slice expiry with company or
+	   on wakeups, so a solo spinner's ^C had no delivery
+	   vehicle).  PFL_CHKSIG (bit 0 of p_flags, ptab offset 1) is
+	   set by ssig; chksigs applies default dispositions right
+	   here (doexit never returns — frame abandoned, harmless)
+	   and stages caught ones for the next kernel exit. */
+	mov _udata,r0		/* u_ptab (offset 0) */
+	bitb $1,1(r0)		/* p_flags & PFL_CHKSIG */
+	beq 8f
+	jsr pc,_chksigs		/* regs are saved; C may clobber */
+
+	/* Caught-signal delivery (task #13): chksigs staged a caught
+	   signal in u_cursig — deliver on this tick, which is what
+	   gives a solo spinner's handler tick latency instead of
+	   next-syscall latency.  Frame: r5..r0 at 0..10(sp),
+	   PC 12(sp), PSW 14(sp).  The frame pops at 8f then load
+	   stale r0/r1 into the handler's entry registers — harmless,
+	   they are call-clobbered and the real values are in the
+	   user-stack frame. */
+	tstb _udata+U_DATA__U_CURSIG
+	beq 8f
+	mov 8(sp),-(sp)		/* arg ur1 (saved r1) */
+	mov 12(sp),-(sp)	/* arg ur0 (saved r0: 10 + 2) */
+	mov 18(sp),-(sp)	/* arg upsw (PSW: 14 + 4) */
+	mov 18(sp),-(sp)	/* arg upc  (PC: 12 + 6) */
+	jsr pc,_sig_deliver
+	add $8,sp
+	tst r0
+	beq 8f
+	mov r0,12(sp)		/* rti enters the handler */
+	br 8f
+
+7:	/* Full preempt: restore the interrupted user registers, then
+	   detour through preempt_switchout (which re-saves them in a
+	   switchout frame, chksigs included).  On resume the rti
+	   below consumes the original trap frame — the user continues
+	   exactly where the tick landed. */
+	clrb _need_resched
+	mov (sp)+,r5
+	mov (sp)+,r4
+	mov (sp)+,r3
+	mov (sp)+,r2
+	mov (sp)+,r1
+	mov (sp)+,r0
+	jsr pc,_preempt_switchout
+
+	/* Resume point.  Caught-signal delivery (task #13): chksigs
+	   ran at switch-OUT (tricks.S) and a caught signal staged
+	   there was stashed with the udata — it must deliver on THIS
+	   return, not at some future syscall.  Frame here is bare:
+	   PC 0(sp), PSW 2(sp); user registers are live, so r0/r1 are
+	   preserved around the check (the non-delivery raced-SIG_IGN
+	   path must not clobber them). */
+	tstb _udata+U_DATA__U_CURSIG
+	beq 6f
+	mov r0,-(sp)		/* live user r0/r1 */
+	mov r1,-(sp)
+	/* now: r1 0(sp), r0 2(sp), PC 4(sp), PSW 6(sp) */
+	mov r1,-(sp)		/* arg ur1 */
+	mov r0,-(sp)		/* arg ur0 */
+	mov 10(sp),-(sp)	/* arg upsw (PSW: 6 + 4 pushes) */
+	mov 10(sp),-(sp)	/* arg upc  (PC: 4 + 6 pushes) */
+	jsr pc,_sig_deliver
+	add $8,sp
+	tst r0
+	beq 5f
+	mov r0,4(sp)		/* PC slot: rti enters the handler */
+5:	mov (sp)+,r1
+	mov (sp)+,r0
+6:	rti
+
+8:	mov (sp)+,r5
+	mov (sp)+,r4
+	mov (sp)+,r3
+	mov (sp)+,r2
+	mov (sp)+,r1
+	mov (sp)+,r0
+	rti
+
+/*
+ * Interrupt entry: DL11 receivers (vector 060 console, 0300 tty2)
+ *
+ * Both vectors share this stub; the C handler drains both ports,
+ * so it does not need to know which one fired.
+ */
+interrupt_tty:
+	mov r0,-(sp)
+	mov r1,-(sp)
+	mov r2,-(sp)
+	mov r3,-(sp)
+	mov r4,-(sp)
+	mov r5,-(sp)
+	incb _udata+U_DATA__U_ININTERRUPT
+	jsr pc,_tty_rx_interrupt
+	decb _udata+U_DATA__U_ININTERRUPT
+	mov (sp)+,r5
+	mov (sp)+,r4
+	mov (sp)+,r3
+	mov (sp)+,r2
+	mov (sp)+,r1
+	mov (sp)+,r0
+	rti
+
+/*
+ * Stray interrupt catcher
+ */
+interrupt_stray:
+	rti
+
+/*
+ * Trap handlers
+ *
+ * For now, all traps except TRAP (syscall) just print a message
+ * and halt. The syscall path will need a proper implementation
+ * for user-mode processes.
+ */
+
+trap_syscall:
+	/* TRAP instruction = Fuzix syscall entry
+	 *
+	 * Userspace convention (from syscall_pdp11.c):
+	 *   R0 = arg0, R1 = arg1, R2 = arg2
+	 *   TRAP $N  (N = syscall number in low byte of instruction)
+	 *
+	 * On return: R0 = retval, R1 = error (0 = no error)
+	 *
+	 * Hardware pushes PSW first then PC onto kernel stack
+	 * (SP swap already done by sequencer):
+	 *   (sp)   = old PC (pushed last, at top)
+	 *   2(sp)  = old PSW (pushed first, below)
+	 */
+	mov r0,-(sp)
+	mov r1,-(sp)
+	mov r2,-(sp)
+	mov r3,-(sp)
+	mov r4,-(sp)
+	mov r5,-(sp)
+
+	/* Honest u_insys (preempt campaign): the core's slice-expiry
+	   check (process.c) only fires when u_insys is CLEAR, and it
+	   was stuck at 1 from create_init forever — no spinner could
+	   ever be preempted.  Set here, cleared at exit and in
+	   doexec (which is how exec and init leave the kernel). */
+	movb $1,_udata+6	/* u_insys (offset 6) */
+
+	/* Extract syscall number from TRAP instruction operand.
+	 * Stack after pushing r5-r0: 6 words (12 bytes) of saved regs,
+	 * then trap frame: old PC at 12(sp), old PSW at 14(sp).
+	 * TRAP word is at (PC - 2). Low byte = syscall number.
+	 */
+	mov 12(sp),r3		/* trapped PC (past TRAP instruction) */
+	sub $2,r3		/* back to TRAP instruction word */
+	/* The TRAP instruction is in user space: read it with MFPI.
+	   The trap set the previous mode to user. */
+	mfpi (r3)
+	mov (sp)+,r3
+	bic $0xFF00,r3		/* zero-extend (movb sign-extends) */
+
+	/* Set up udata fields for unix_syscall */
+	movb r3,_udata+7	/* u_callno (offset 7, uint8_t) */
+	mov r0,_udata+18	/* u_argn */
+	mov r1,_udata+20	/* u_argn1 */
+	mov r2,_udata+22	/* u_argn2 */
+
+	/* Vector 034 PSW is priority 7; Fuzix runs syscalls with
+	   interrupts ENABLED (otherwise a blocking read sleeps into
+	   the scheduler at pri 7 and plt_idle's WAIT never wakes). */
+	bic $0340,*$0177776
+
+	jsr pc,_unix_syscall
+
+	/* Caught-signal delivery (task #13): a signal staged during
+	   the syscall — by the unix_syscall epilogue's chksigs or a
+	   blocking body — is delivered on THIS kernel exit.
+	   sig_deliver builds the frame on the user stack; we redirect
+	   the trap-frame PC into the handler.  The r0/r1 it preserves
+	   are u_retval/u_error: what the interrupted code sees on
+	   resume (an EINTR'd read keeps its -1/EINTR).  Frame here:
+	   r5..r0 at 0..10(sp), PC 12(sp), PSW 14(sp); args push
+	   right-to-left, caller pops (gcc-pdp11 ABI). */
+	tstb _udata+U_DATA__U_CURSIG
+	beq 5f
+	mov _udata+12,-(sp)	/* arg ur1 = u_error */
+	mov _udata+10,-(sp)	/* arg ur0 = u_retval */
+	mov 18(sp),-(sp)	/* arg upsw (PSW: 14 + 4 pushes) */
+	mov 18(sp),-(sp)	/* arg upc  (PC: 12 + 6 pushes) */
+	jsr pc,_sig_deliver
+	add $8,sp		/* caller pops the four args */
+	tst r0
+	beq 5f
+	mov r0,12(sp)		/* rti enters the handler */
+5:
+	/* Return: R0 = retval, R1 = error */
+	mov _udata+10,r0	/* u_retval */
+	mov _udata+12,r1	/* u_error */
+
+	clrb _udata+6		/* u_insys: leaving the kernel */
+
+	mov (sp)+,r5
+	mov (sp)+,r4
+	mov (sp)+,r3
+	mov (sp)+,r2
+	/* R1 and R0 restored from udata, skip saved copies */
+	add $4,sp		/* skip saved r1 and r0 */
+	rti
+
+/*
+ * A trap in user mode is the program's fault: plt_usertrap(vector)
+ * sends it a signal (SIGBUS, SIGILL, SIGTRAP, SIGIOT, SIGEMT) and
+ * the process dies or its handler runs, as for trap_mmu.  In kernel
+ * mode these traps are fatal.
+ */
+trap_bus:
+	mov $4,trapvec
+	mov $msg_bus,trapmsg
+	br trap_maybe_user
+trap_ill:
+	mov $010,trapvec
+	mov $msg_ill,trapmsg
+	br trap_maybe_user
+trap_bpt:
+	mov $014,trapvec
+	mov $msg_bpt,trapmsg
+	br trap_maybe_user
+trap_iot:
+	mov $020,trapvec
+	mov $msg_iot,trapmsg
+	br trap_maybe_user
+trap_pwr:
+	mov $msg_pwr,r0
+	br trap_fatal
+trap_emt:
+	mov $030,trapvec
+	mov $msg_emt,trapmsg
+	/* fall through */
+trap_maybe_user:
+	bit $0140000,2(sp)	/* previous mode user? */
+	bne 1f
+	mov trapmsg,r0
+	br trap_fatal
+1:	mov r0,-(sp)
+	mov r1,-(sp)
+	mov r2,-(sp)
+	mov r3,-(sp)
+	mov r4,-(sp)
+	mov r5,-(sp)
+	mov trapvec,-(sp)
+	jsr pc,_plt_usertrap
+	add $2,sp
+	br trap_user_ret
+
+	.data
+trapvec:	.word 0
+trapmsg:	.word 0
+	.text
+trap_mmu:
+	/* A user-mode fault is the process's problem, not the
+	   machine's: deliver SIGSEGV (default disposition kills the
+	   process via chksigs) and carry on.  Kernel-mode faults
+	   stay fatal.  Mode bits [15:14] of the pushed PSW: 00 =
+	   kernel, 11 = user. */
+	bit $0140000, 2(sp)
+	beq trap_mmu_fatal
+	mov r0,-(sp)
+	mov r1,-(sp)
+	mov r2,-(sp)
+	mov r3,-(sp)
+	mov r4,-(sp)
+	mov r5,-(sp)
+	jsr pc,_plt_usermmu
+trap_user_ret:
+	/* Held signals resume (and possibly refault); default SIGSEGV
+	   never returns — the process is gone and we run something
+	   else.  A CAUGHT SIGSEGV is staged in u_cursig: deliver it
+	   now (task #13), else the process would refault forever.
+	   Frame: r5..r0 at 0..10(sp), PC 12(sp), PSW 14(sp). */
+	tstb _udata+U_DATA__U_CURSIG
+	beq 4f
+	mov 8(sp),-(sp)		/* arg ur1 (saved r1) */
+	mov 12(sp),-(sp)	/* arg ur0 (saved r0: 10 + 2) */
+	mov 18(sp),-(sp)	/* arg upsw (PSW: 14 + 4) */
+	mov 18(sp),-(sp)	/* arg upc  (PC: 12 + 6) */
+	jsr pc,_sig_deliver
+	add $8,sp
+	tst r0
+	beq 4f
+	mov r0,12(sp)		/* rti enters the handler */
+4:	mov (sp)+,r5
+	mov (sp)+,r4
+	mov (sp)+,r3
+	mov (sp)+,r2
+	mov (sp)+,r1
+	mov (sp)+,r0
+	rti
+
+trap_mmu_fatal:
+	mov $msg_mmu,r0
+	/* fall through */
+
+trap_fatal:
+	bis $0340,*$0177776	/* IRQ off */
+	/* Output faulting PC using only outchar (no outstring) */
+	mov $041,r0		/* '!' */
+	jsr pc,outchar
+	/* Trap frame: (sp) = PC, 2(sp) = PSW */
+	mov (sp),r0		/* trapped PC */
+	jsr pc,outr0hex
+	mov $040,r0		/* space */
+	jsr pc,outchar
+	mov 2(sp),r0		/* trapped PSW */
+	jsr pc,outr0hex
+	mov $012,r0		/* newline */
+	jsr pc,outchar
+	halt
+
+msg_bus:
+	.asciz "\r\nBUS ERR PC="
+msg_ill:
+	.asciz "\r\nILL INST PC="
+msg_bpt:
+	.asciz "\r\nBPT PC="
+msg_iot:
+	.asciz "\r\nIOT PC="
+msg_pwr:
+	.asciz "\r\nPOWER FAIL PC="
+msg_emt:
+	.asciz "\r\nEMT PC="
+msg_mmu:
+	.asciz "\r\nMMU ABORT PC="
+	.even
+
diff --git a/Kernel/platform/platform-pdp11dec/pdp11_endian_fix.py b/Kernel/platform/platform-pdp11dec/pdp11_endian_fix.py
new file mode 100644
index 000000000..12a929539
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/pdp11_endian_fix.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""
+Post-process a Fuzix filesystem image to convert 32-bit fields from
+little-endian (x86 host) to PDP-endian (word-swapped).
+
+PDP-11 GCC stores uint32_t with the HIGH word at the lower address.
+x86 stores uint32_t with the LOW word at the lower address.
+This script swaps the two 16-bit halves of every 32-bit field in the
+superblock and all inodes.
+"""
+import struct
+import sys
+
+BLOCK_SIZE = 512
+INODE_SIZE = 64
+INODES_PER_BLOCK = BLOCK_SIZE // INODE_SIZE  # 8
+
+# Offsets of uint32_t fields within a 64-byte dinode
+INODE_U32_OFFSETS = [8, 12, 16, 20]  # i_size, i_atime, i_mtime, i_ctime
+
+# Superblock: s_time is the only uint32_t
+# Layout: s_mounted(2) + s_isize(2) + s_fsize(2) + s_nfree(2) + s_free[50](100)
+#        + s_ninode(2) + s_inode[50](100) + s_fmod(1) + s_timeh(1) + s_time(4)
+SUPER_S_ISIZE_OFF = 2
+SUPER_S_TIME_OFF = 212
+
+
+def swap_word_pairs(data, offset):
+    """Swap the two 16-bit words of a uint32_t at the given offset."""
+    lo = struct.unpack_from('<H', data, offset)[0]
+    hi = struct.unpack_from('<H', data, offset + 2)[0]
+    struct.pack_into('<H', data, offset, hi)
+    struct.pack_into('<H', data, offset + 2, lo)
+
+
+def main():
+    if len(sys.argv) != 2:
+        print(f"Usage: {sys.argv[0]} <filesystem.img>", file=sys.stderr)
+        sys.exit(1)
+
+    path = sys.argv[1]
+    with open(path, 'rb') as f:
+        data = bytearray(f.read())
+
+    # Read s_isize from superblock (block 1)
+    sb_off = BLOCK_SIZE  # block 1
+    s_isize = struct.unpack_from('<H', data, sb_off + SUPER_S_ISIZE_OFF)[0]
+    print(f"  s_isize = {s_isize} (inode blocks 2..{s_isize - 1})")
+
+    # Swap superblock s_time
+    swap_word_pairs(data, sb_off + SUPER_S_TIME_OFF)
+
+    # Swap all inode 32-bit fields (blocks 2 through s_isize-1)
+    n_swapped = 0
+    for blk in range(2, s_isize):
+        blk_off = blk * BLOCK_SIZE
+        for i in range(INODES_PER_BLOCK):
+            ino_off = blk_off + i * INODE_SIZE
+            for field_off in INODE_U32_OFFSETS:
+                swap_word_pairs(data, ino_off + field_off)
+            n_swapped += 1
+
+    print(f"  Swapped {n_swapped} inodes, {n_swapped * 4 + 1} fields")
+
+    with open(path, 'wb') as f:
+        f.write(data)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/Kernel/platform/platform-pdp11dec/rules.mk b/Kernel/platform/platform-pdp11dec/rules.mk
new file mode 100644
index 000000000..d60ecf858
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/rules.mk
@@ -0,0 +1,12 @@
+# Parsed by Kernel/Makefile (cwd = Kernel/) after target.mk.
+#
+# Kernel objects bake PROGBASE/PROGTOP and friends in from the
+# platform config.h, but nothing tracked that dependency: after a
+# config.h edit an incremental build links a chimera of old- and
+# new-geometry objects (2026-07-13: a stale valaddr rejected the
+# whole relocated user space -> "panic: no /init").  Make the
+# dependency explicit so config.h changes rebuild the world.
+PLATFORM_CONFIG_H = platform/platform-$(TARGET)/config.h
+$(patsubst %.c,%.o,$(wildcard *.c)): $(PLATFORM_CONFIG_H)
+$(patsubst %.c,%.o,$(wildcard cpu-$(CPU)/*.c)): $(PLATFORM_CONFIG_H)
+$(patsubst %.S,%.o,$(wildcard cpu-$(CPU)/*.S)): $(PLATFORM_CONFIG_H)
diff --git a/Kernel/platform/platform-pdp11dec/sigtest.c b/Kernel/platform/platform-pdp11dec/sigtest.c
new file mode 100644
index 000000000..0910b6e54
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/sigtest.c
@@ -0,0 +1,118 @@
+/*
+ * sigtest — caught-signal trampoline validation (task #13).
+ *
+ * Exercises every leg of the pdp11 signal delivery path with
+ * deterministic, probe-friendly output (tb_sigprobe and the
+ * silicon probe grep these needles):
+ *
+ *   PHASE 1 — compute leg (ISR-tail delivery).  Installs a SIGINT
+ *     handler, prints "READY SUM xxxx", then runs a register-
+ *     resident checksum spinner.  ^C mid-spin must print "CAUGHT"
+ *     from the handler and the interrupted lap must still total
+ *     the reference sum: a corrupted r2-r5, a lost PSW or a
+ *     misplaced resume PC all show up as "PHASE1 SUM MISMATCH".
+ *     Ends "PHASE1 OK LAPS n".
+ *
+ *   PHASE 2 — blocking leg (syscall-exit delivery).  Reinstalls
+ *     the handler (the previous delivery auto-reset it — V7
+ *     semantics), prints "PHASE2 READY", blocks in read().  ^C
+ *     must run the handler AND interrupt the read with EINTR:
+ *     "PHASE2 OK EINTR".
+ *
+ *   PHASE 3 — V7 reset (default disposition).  The phase-2
+ *     delivery reset the vector to SIG_DFL and we do NOT
+ *     reinstall.  Prints "PHASE3 READY" and spins; the next ^C
+ *     must KILL the process — the probe's needle is the shell
+ *     prompt coming back, and anything printed after PHASE3 READY
+ *     other than the death is a failure.
+ *
+ * The handler uses write() only: stdio is not reentrant.
+ */
+
+#include <stdio.h>
+#include <unistd.h>
+#include <signal.h>
+#include <errno.h>
+
+#define INNER 20000		/* ~80 ms/lap at 25 MHz: several
+				   clock ticks land inside every lap */
+
+static volatile int caught;
+
+static void handler(int sig)
+{
+	write(1, "CAUGHT\n", 7);
+	caught++;
+}
+
+/* One lap of register-resident arithmetic from a fixed starting
+   state: every call returns the same value.  At -Os (verified by
+   disassembly, inlined into main) the working set spans BOTH
+   register classes — a/d in call-clobbered r0/r1 (exercises the
+   kernel's frame save + __sigreturn restore), b/c in callee-saved
+   r4/r2 (exercises ABI preservation through the C handler) — and
+   the loop counter's dec/beq pair keeps live condition codes that
+   a lossy rtt would corrupt into a wrong lap count.  Any of those
+   failures diverges the total.  EIS-free by design (no mul/shift):
+   the emulator has its own coverage. */
+static unsigned int lap(void)
+{
+	unsigned int a = 0, b = 1, c = 3, d = 7;
+	int i;
+
+	for (i = 0; i < INNER; i++) {
+		a += b;
+		b ^= c;
+		c += d;
+		d += a | 1;
+	}
+	return a + b + c + d;
+}
+
+int main(int argc, char *argv[])
+{
+	unsigned int ref;
+	int laps, n;
+	char buf[32];
+
+	/* PHASE 1: catch mid-compute, prove register-exact resume */
+	signal(SIGINT, handler);
+	ref = lap();
+	printf("READY SUM %04x\n", ref);
+	fflush(stdout);
+	laps = 1;
+	while (!caught) {
+		if (lap() != ref) {
+			printf("PHASE1 SUM MISMATCH\n");
+			return 1;
+		}
+		laps++;
+	}
+	/* one clean lap after the catch: steady state holds too */
+	if (lap() != ref) {
+		printf("PHASE1 SUM MISMATCH\n");
+		return 1;
+	}
+	printf("PHASE1 OK LAPS %d\n", laps);
+	fflush(stdout);
+
+	/* PHASE 2: catch in a blocking read, prove EINTR */
+	signal(SIGINT, handler);	/* delivery reset it: reinstall */
+	caught = 0;
+	printf("PHASE2 READY\n");
+	fflush(stdout);
+	n = read(0, buf, sizeof(buf));
+	if (n < 0 && errno == EINTR && caught)
+		printf("PHASE2 OK EINTR\n");
+	else
+		printf("PHASE2 FAIL n=%d errno=%d caught=%d\n",
+		       n, errno, caught);
+	fflush(stdout);
+
+	/* PHASE 3: vector auto-reset to SIG_DFL, NOT reinstalled —
+	   the next ^C must kill us (shell prompt = pass) */
+	printf("PHASE3 READY\n");
+	fflush(stdout);
+	for (;;)
+		lap();
+}
