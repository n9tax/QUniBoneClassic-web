diff --git a/Kernel/platform/platform-pdp11dec/dev_rl.c b/Kernel/platform/platform-pdp11dec/dev_rl.c
new file mode 100644
index 000000000..9a0364601
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/dev_rl.c
@@ -0,0 +1,268 @@
+/*
+ * RL11/RL02 disk driver for Fuzix
+ *
+ * Single-drive RL02 on STENSAT FPGA PDP-11/20.
+ * RL02 geometry: 512 cylinders, 2 heads, 40 sectors/track, 256 bytes/sector.
+ * Each RL02 sector = 256 bytes = 128 words.
+ * Fuzix block = 512 bytes = 2 RL02 sectors.
+ *
+ * Disk layout (in RL02 sectors of 256 bytes):
+ *   Sectors   0-3     Boot block (loaded by ROM to address 0)
+ *   Sectors   4-127   Kernel image (bootloader loads to 0x0200)
+ *   Sectors 128-16383 Root filesystem (minor 0)  ~8 MB
+ *   Sectors 16384-20479 Swap partition (minor 1) ~2 MB
+ *
+ * Since Fuzix blocks are 512 bytes and RL02 sectors are 256 bytes,
+ * each Fuzix block = 2 consecutive RL02 sectors.
+ *
+ * RL11 registers:
+ *   174400 RLCS  Control/Status
+ *   174402 RLBA  Bus Address
+ *   174404 RLDA  Disk Address {cylinder[15:7], head[6], sector[5:0]}
+ *   174406 RLMP  Word count (negative, two's complement)
+ */
+
+#include <kernel.h>
+#include <kdata.h>
+#include <printf.h>
+#include <dev_rl.h>
+
+/* RL11 register addresses */
+#define RLCS  (*(volatile uint16_t *)0174400)
+#define RLBA  (*(volatile uint16_t *)0174402)
+#define RLDA  (*(volatile uint16_t *)0174404)
+#define RLMP  (*(volatile uint16_t *)0174406)
+
+/* RLCS bits */
+#define RLCS_DRDY   0x0001   /* Drive ready */
+#define RLCS_FUNC   0x000E   /* Function code [3:1] */
+#define RLCS_GO     0x0001   /* GO bit (same position, sets with func) */
+#define RLCS_IE     0x0040   /* Interrupt enable */
+#define RLCS_CRDY   0x0080   /* Controller ready */
+#define RLCS_ERR    0x8000   /* Composite error */
+
+/* Function codes (shifted into bits [3:1]) */
+#define RL_NOP      (0 << 1)
+#define RL_WCHK     (1 << 1)
+#define RL_GETSTAT  (2 << 1)
+#define RL_SEEK     (3 << 1)
+#define RL_RDHDR    (4 << 1)
+#define RL_WRITE    (5 << 1)
+#define RL_READ     (6 << 1)
+#define RL_RDNOHDR  (7 << 1)
+
+/* Partition offsets in RL02 sectors (256 bytes each) */
+#define PART0_START  256     /* Root filesystem */
+#define PART0_SIZE   16128   /* Sectors 256-16383 */
+#define PART1_START  16384   /* Swap */
+#define PART1_SIZE   4096    /* Sectors 16384-20479 */
+
+/* Convert linear RL02 sector to RLDA value */
+static uint16_t sector_to_rlda(uint16_t linear)
+{
+    uint16_t sector = linear % 40;
+    uint16_t head = (linear / 40) % 2;
+    uint16_t cylinder = linear / 80;
+    return (cylinder << 7) | (head << 6) | sector;
+}
+
+/* Wait for controller ready */
+static void rl_wait(void)
+{
+    while (!(RLCS & RLCS_CRDY))
+        ;
+}
+
+/* Current cylinder tracking (avoids unnecessary seeks) */
+static uint16_t cur_cyl = 0xFFFF;  /* unknown */
+
+/* Seek to the cylinder containing an RL02 linear sector */
+static void rl_seek(uint16_t linear)
+{
+    uint16_t target_cyl = linear / 80;
+    int16_t diff;
+    uint16_t da;
+
+    if (target_cyl == cur_cyl)
+        return;
+
+    diff = target_cyl - cur_cyl;
+
+    /* Get Status to confirm drive is ready */
+    rl_wait();
+    RLDA = 0x04;   /* Get Status, reset errors */
+    RLCS = RL_GETSTAT | RLCS_GO;
+    rl_wait();
+
+    if (cur_cyl == 0xFFFF) {
+        /* Unknown position — Read Header to find current cylinder */
+        RLCS = RL_RDHDR | RLCS_GO;
+        rl_wait();
+        cur_cyl = (RLMP >> 7) & 0x1FF;
+        diff = target_cyl - cur_cyl;
+    }
+
+    if (diff == 0) {
+        cur_cyl = target_cyl;
+        return;
+    }
+
+    /* Build seek RLDA: {difference[15:7], 0, head_select[4], 0, direction[2], 0, 0} */
+    if (diff > 0) {
+        da = (diff << 7) | 0x04;   /* outward (away from cyl 0), bit 2=1 */
+    } else {
+        da = ((-diff) << 7);        /* inward (toward cyl 0), bit 2=0 */
+    }
+
+    rl_wait();
+    RLDA = da;
+    RLCS = RL_SEEK | RLCS_GO;
+    rl_wait();
+
+    cur_cyl = target_cyl;
+}
+
+/*
+ * Transfer one Fuzix block (512 bytes = 2 RL02 sectors).
+ * The RL11 DMA reads 256 bytes per sector, so we issue two
+ * consecutive sector reads/writes.
+ */
+static int rl_transfer(bool is_read, uint8_t minor, uint8_t rawflag)
+{
+    uint16_t ct = 0;
+    uint16_t part_start;
+    uint16_t part_size;
+    uint16_t cmd;
+    irqflags_t irq = 0;
+
+    /* Select partition */
+    if (minor == 0) {
+        part_start = PART0_START;
+        part_size = PART0_SIZE;
+    } else if (minor == 1) {
+        part_start = PART1_START;
+        part_size = PART1_SIZE;
+    } else {
+        udata.u_error = ENODEV;
+        return -1;
+    }
+
+    if (rawflag == 1) {
+        if (d_blkoff(9))
+            return -1;
+    }
+
+    cmd = is_read ? RL_READ : RL_WRITE;
+
+    /* A swap image transfer (rawflag 2) moves a whole bank — 44KB
+       of polled DMA — and the console is deaf for all of it if it
+       runs masked.  It touches only the target bank's pages (user
+       image + that process's udata STASH, which is a frozen copy —
+       never the live udata), and no interrupt handler references
+       either, so interrupts can stay live for the duration; the
+       swap callers hold priority 7 and get it back on the way
+       out. */
+    if (rawflag == 2) {
+        irq = __hard_di();	/* current PSW, to restore below */
+        __hard_ei();
+    }
+
+    while (ct < udata.u_nblock) {
+        /* Convert Fuzix block number to RL02 linear sector.
+         * Each Fuzix block = 2 RL02 sectors (512 / 256).
+         */
+        uint16_t rl_sector = part_start + (udata.u_block << 1);
+
+        /* Bounds check */
+        if ((udata.u_block << 1) + 2 > part_size) {
+            udata.u_error = EIO;
+            break;
+        }
+
+        /* Seek to the correct cylinder */
+        rl_seek(rl_sector);
+
+        /* User-space buffers live in a bank: 18 bit physical =
+         * bank_click[page] * 64 + 0x200 + (va - PROGBASE), i.e. bank
+         * base + (va - SWAPBASE).  Bits 15:0 go to RLBA, bits 17:16
+         * to RLCS bits 5:4.  Swap legs (rawflag 2) use the swapper's
+         * target bank (swappage, maybe not the running process); raw
+         * user I/O (rawflag 1) uses udata.u_page.  rawflag 0 is a
+         * kernel address (buffer cache), identity mapped. */
+        uint16_t bufva = (uint16_t)udata.u_dptr;
+        uint16_t lo, hi;
+        if (rawflag) {
+            uint16_t page = (rawflag == 2) ? swappage : udata.u_page;
+            uint16_t off = bufva - (uint16_t)SWAPBASE;
+            uint16_t click = bank_click[page] + (off >> 6);
+            lo = (click << 6) | (off & 63);
+            hi = click >> 10;
+        } else {
+            lo = bufva;
+            hi = 0;
+        }
+
+        /* First half: 128 words (256 bytes) */
+        rl_wait();
+        RLBA = lo;
+        RLDA = sector_to_rlda(rl_sector);
+        RLMP = (uint16_t)-128;  /* 128 words = 256 bytes */
+        RLCS = cmd | ((hi & 3) << 4) | RLCS_GO;
+
+        rl_wait();
+        if (RLCS & RLCS_ERR) {
+            kprintf("rl%d: err blk %d rlcs=%x\n",
+                    minor, udata.u_block, RLCS);
+            udata.u_error = EIO;
+            break;
+        }
+
+        /* Second half: next RL02 sector, next 256 bytes of buffer —
+         * recompute the 18-bit address (the +256 may carry). */
+        {
+            uint16_t lo2 = lo + 256;
+            uint16_t hi2 = hi + (lo2 < lo);
+            RLBA = lo2;
+            RLDA = sector_to_rlda(rl_sector + 1);
+            RLMP = (uint16_t)-128;
+            RLCS = cmd | ((hi2 & 3) << 4) | RLCS_GO;
+        }
+
+        rl_wait();
+        if (RLCS & RLCS_ERR) {
+            kprintf("rl%d: err blk %d rlcs=%o\n",
+                    minor, udata.u_block, RLCS);
+            udata.u_error = EIO;
+            break;
+        }
+
+        udata.u_block++;
+        udata.u_dptr += 512;
+        ct++;
+    }
+    if (rawflag == 2)
+        __hard_irqrestore(irq);
+    return ct << 9;
+}
+
+int rl_open(uint8_t minor, uint16_t flag)
+{
+    flag;
+    if (minor > 1) {
+        udata.u_error = ENODEV;
+        return -1;
+    }
+    return 0;
+}
+
+int rl_read(uint8_t minor, uint8_t rawflag, uint8_t flag)
+{
+    flag;
+    return rl_transfer(true, minor, rawflag);
+}
+
+int rl_write(uint8_t minor, uint8_t rawflag, uint8_t flag)
+{
+    flag;
+    return rl_transfer(false, minor, rawflag);
+}
diff --git a/Kernel/platform/platform-pdp11dec/dev_rl.h b/Kernel/platform/platform-pdp11dec/dev_rl.h
new file mode 100644
index 000000000..1e5efaead
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/dev_rl.h
@@ -0,0 +1,11 @@
+#ifndef __DEV_RL_DOT_H__
+#define __DEV_RL_DOT_H__
+
+int rl_open(uint8_t minor, uint16_t flag);
+int rl_read(uint8_t minor, uint8_t rawflag, uint8_t flag);
+int rl_write(uint8_t minor, uint8_t rawflag, uint8_t flag);
+
+/* Physical base of each user bank in 64 byte clicks (main.c) */
+extern uint16_t bank_click[];
+
+#endif
