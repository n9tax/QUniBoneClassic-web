diff --git a/Kernel/platform/platform-pdp11dec/divmod.S b/Kernel/platform/platform-pdp11dec/divmod.S
new file mode 100644
index 000000000..213c23b20
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/divmod.S
@@ -0,0 +1,70 @@
+/*
+ * Unsigned 16-bit division helpers for PDP-11 (no EIS)
+ * Required by GCC when no libgcc is available.
+ *
+ * Calling convention (pdp11-aout-gcc):
+ *   jsr pc,func  — pushes return addr
+ *   2(sp) = dividend, 4(sp) = divisor
+ *   Result in r0. r2-r5 callee-saved.
+ */
+
+	.text
+	.globl ___udivhi3
+	.globl ___umodhi3
+
+/*
+ * ___udivhi3: r0 = dividend / divisor
+ */
+___udivhi3:
+	mov r2,-(sp)		/* save r2 */
+	mov 4(sp),r0		/* dividend */
+	mov 6(sp),r1		/* divisor */
+	jsr pc,udiv16
+	/* r0 = quotient (already there) */
+	mov (sp)+,r2		/* restore r2 */
+	rts pc
+
+/*
+ * ___umodhi3: r0 = dividend % divisor
+ */
+___umodhi3:
+	mov r2,-(sp)		/* save r2 */
+	mov 4(sp),r0		/* dividend */
+	mov 6(sp),r1		/* divisor */
+	jsr pc,udiv16
+	mov r1,r0		/* remainder → r0 */
+	mov (sp)+,r2		/* restore r2 */
+	rts pc
+
+/*
+ * udiv16: unsigned 16-bit restoring division
+ *
+ * Input:  r0 = dividend, r1 = divisor
+ * Output: r0 = quotient, r1 = remainder
+ * Clobbers: r2
+ */
+udiv16:
+	tst r1
+	beq 9f			/* division by zero → return 0,0 */
+	mov r0,r2		/* r2 = dividend (shifted out) */
+	clr r0			/* r0 = remainder (built up) */
+	/* 16 iterations unrolled as a counted loop */
+	mov $16,-(sp)		/* loop counter */
+1:
+	asl r2			/* shift dividend left; MSB → C */
+	rol r0			/* shift carry into remainder */
+	cmp r0,r1		/* remainder >= divisor? (unsigned) */
+	blo 2f
+	sub r1,r0		/* remainder -= divisor */
+	inc r2			/* set quotient bit */
+2:
+	dec (sp)
+	bne 1b
+	tst (sp)+		/* pop counter */
+	mov r0,r1		/* r1 = remainder */
+	mov r2,r0		/* r0 = quotient */
+	rts pc
+9:
+	clr r0
+	clr r1
+	rts pc
