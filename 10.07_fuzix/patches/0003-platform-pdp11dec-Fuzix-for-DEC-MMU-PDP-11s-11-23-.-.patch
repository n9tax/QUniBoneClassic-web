diff --git a/Kernel/platform/platform-pdp11dec/fuzix.ld b/Kernel/platform/platform-pdp11dec/fuzix.ld
new file mode 100644
index 000000000..bf676c4fd
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/fuzix.ld
@@ -0,0 +1,58 @@
+STARTUP(crt0.o)
+OUTPUT_ARCH(pdp11)
+
+SEARCH_DIR(.)
+
+MEMORY
+{
+  ram (rwx) : ORIGIN = 0x0200, LENGTH = 0xDC00
+}
+
+/*
+ * Kernel occupies virtual 0x0200 - 0xDDFF (max ~55KB)
+ * 0x0000-0x01FF: trap vectors (written at runtime)
+ * 0xE000-0xFFFF: I/O page (MMU page 7)
+ */
+SECTIONS
+{
+  .text :
+  {
+    CREATE_OBJECT_SYMBOLS
+    *(.text .text.*)
+
+    . = ALIGN(0x2);
+    *(.rodata .rodata.*)
+
+    . = ALIGN(0x2);
+    _etext = .;
+  } > ram
+
+  .data :
+  {
+    *(.got.plt) *(.got)
+    *(.shdata)
+    *(.data .data.*)
+    _edata = .;
+  } > ram
+
+  .bss :
+  {
+    . = ALIGN(0x2);
+    __bss_start = . ;
+    *(.shbss)
+    *(.bss .bss.*)
+    *(COMMON)
+    _end =  ALIGN (0x2);
+    __end = _end;
+  } > ram
+
+  .stab 0 (NOLOAD) :
+  {
+    *(.stab)
+  }
+
+  .stabstr 0 (NOLOAD) :
+  {
+    *(.stabstr)
+  }
+}
diff --git a/Kernel/platform/platform-pdp11dec/fuzix_simh.ini b/Kernel/platform/platform-pdp11dec/fuzix_simh.ini
