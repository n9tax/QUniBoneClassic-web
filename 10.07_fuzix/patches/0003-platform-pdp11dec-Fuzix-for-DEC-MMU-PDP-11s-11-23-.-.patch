diff --git a/Kernel/platform/platform-pdp11dec/Makefile b/Kernel/platform/platform-pdp11dec/Makefile
new file mode 100644
index 000000000..5fda23c30
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/Makefile
@@ -0,0 +1,45 @@
+
+CSRCS = devtty.c
+CSRCS += devices.c main.c libc.c dev_rl.c
+
+ASRCS = pdp11.S crt0.S
+ASRCS += tricks.S divmod.S usermem_mfpi.S
+
+DSRCS = 
+DOBJS = $(patsubst ../../dev/%.c,%.o, $(DSRCS))
+
+COBJS = $(CSRCS:.c=$(BINEXT))
+AOBJS = $(ASRCS:.S=.o)
+OBJS  = $(COBJS) $(AOBJS) $(DOBJS)
+
+JUNK = $(CSRCS:.c=.o) $(ASRCS:.S=.o)
+
+all:	$(OBJS)
+
+# config.h geometry is baked into every object (see rules.mk for
+# the same dependency on the core kernel objects)
+$(OBJS): config.h
+
+$(COBJS): %.o: %.c
+	$(CROSS_CC) $(CROSS_CCOPTS) -c $<
+
+$(AOBJS): %.o: %.S
+	$(CROSS_AS) $(ASOPTS) $< -o $*.o
+
+$(DOBJS): %.o: ../../dev/%.c
+	$(CROSS_CC) $(CROSS_CCOPTS) -c $<
+
+clean:
+	rm -f $(OBJS) $(JUNK)  core *~ 
+
+image:
+	$(CROSS_LD) -M -o fuzix.aout -T fuzix.ld \
+	crt0.o \
+	../../start.o ../../version.o ../../cpu-pdp11/lowlevel-pdp11.o \
+	main.o ../../swap.o ../../timer.o ../../bankfixed.o ../../kdata.o devices.o \
+	../../tty.o ../../devio.o ../../filesys.o ../../process.o ../../inode.o ../../syscall_fs.o \
+	pdp11.o ../../syscall_proc.o ../../syscall_other.o ../../mm.o ../../memalloc_none.o \
+	../../devsys.o ../../usermem.o ../../syscall_exec.o ../../syscall_exec16.o \
+	../../syscall_fs2.o tricks.o ../../syscall_fs3.o ../../blk512.o \
+	usermem_mfpi.o devtty.o libc.o dev_rl.o > ../../fuzix.map
+	pdp11-aout-objcopy fuzix.aout -O binary ../../fuzix.bin
diff --git a/Kernel/platform/platform-pdp11dec/README b/Kernel/platform/platform-pdp11dec/README
new file mode 100644
index 000000000..9ee34d560
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/README
@@ -0,0 +1,18 @@
+At the moment this is just build testing and seeing what in the toolchain
+breaks.
+
+Once it all builds and the syscall and some minimal driver code is filled in
+it ought to come in at about 20KW for a pure swap based system so probably
+not useful on an MMUless /11 except for testing.
+
+Boot notes:
+	start block with nop apparently sometimes needed
+	Generally first block, but on rx appears to be first sector of track 1
+	(not 0 as expected)
+
+Boot logic:
+	Load inode 1 (hardcoded offset)
+	Walk direct link blocks looking for /bootstrap
+	Load only direct blocks of the referenced inode
+
+	Run /bootstrap
diff --git a/Kernel/platform/platform-pdp11dec/boot_fuzix_gas.S b/Kernel/platform/platform-pdp11dec/boot_fuzix_gas.S
new file mode 100644
index 000000000..9c76acb70
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/boot_fuzix_gas.S
@@ -0,0 +1,118 @@
+/*
+ * Fuzix RL02 boot block, GNU as version of boot_fuzix.s.
+ *
+ * A DEC RL boot ROM (or SIMH "boot rl0", or the QBone RL loader) reads
+ * the first 512 bytes of the disk to address 0 and starts at 0.  This
+ * code fits in those 512 bytes.  It loads the kernel from RL02 sectors
+ * 4.. (256 bytes each) to address 01000 and jumps there.
+ *
+ * Numbers are octal when they start with 0, decimal otherwise.
+ */
+	.text
+RLCS	= 0174400
+RLBA	= 0174402
+RLDA	= 0174404
+RLMP	= 0174406
+XCSR	= 0177564
+XBUF	= 0177566
+
+KERN_START = 4
+KERN_NSECT = 190		/* up to 0xC000: 47.5 KB */
+KERN_ADDR  = 01000
+
+	.globl	start
+start:
+	nop			/* boot block signature */
+	br	boot
+
+	. = start + 040
+boot:
+	mov	$0340, @$0177776
+	mov	$KERN_ADDR, sp
+	mov	$msg, r0
+	jsr	pc, puts
+
+	clr	curcyl
+	mov	$KERN_ADDR, r2		/* destination */
+	mov	$KERN_START, r3		/* linear sector */
+	mov	$KERN_NSECT, r4		/* count */
+
+next:
+	tstb	@$RLCS
+	bpl	next
+	/* cylinder = r3 / 80, r0 = r3 % 80 */
+	mov	r3, r0
+	clr	r5
+1:	cmp	r0, $80
+	blo	2f
+	sub	$80, r0
+	inc	r5
+	br	1b
+2:	cmp	r5, curcyl
+	beq	noseek
+
+	/* seek: difference in bits 15:7, bit 2 = outward */
+	mov	r5, r1
+	sub	curcyl, r1
+	bpl	3f
+	neg	r1
+	ash	$7, r1
+	br	4f
+3:	ash	$7, r1
+	bis	$4, r1
+4:	bis	$1, r1			/* marker bit, as DEC's seek uses */
+	mov	r1, @$RLDA
+	mov	$6, @$RLCS		/* seek */
+5:	tstb	@$RLCS
+	bpl	5b
+	tst	@$RLCS
+	bmi	error
+	mov	r5, curcyl
+
+noseek:
+	clr	r1
+	cmp	r0, $40
+	blo	6f
+	sub	$40, r0
+	bis	$0100, r1		/* head 1 */
+6:	bis	r0, r1
+	mov	r5, r0
+	ash	$7, r0
+	bis	r0, r1
+	mov	r2, @$RLBA
+	mov	r1, @$RLDA
+	mov	$-128, @$RLMP		/* 128 words */
+	mov	$014, @$RLCS		/* read data */
+7:	tstb	@$RLCS
+	bpl	7b
+	tst	@$RLCS
+	bmi	error
+	add	$256, r2
+	inc	r3
+	dec	r4
+	bne	next
+
+	mov	$crlf, r0
+	jsr	pc, puts
+	jmp	@$KERN_ADDR
+
+error:
+	mov	$errmsg, r0
+	jsr	pc, puts
+	halt
+	br	error
+
+puts:
+	tstb	@$XCSR
+	bpl	puts
+	movb	(r0)+, r1
+	beq	1f
+	mov	r1, @$XBUF
+	br	puts
+1:	rts	pc
+
+msg:	.asciz	"\r\nLoading Fuzix..."
+crlf:	.asciz	"\r\n"
+errmsg:	.asciz	"\r\nRL11 error\r\n"
+	.even
+curcyl:	.word	0
diff --git a/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh b/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh
new file mode 100755
index 000000000..8c5e0df41
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh
@@ -0,0 +1,489 @@
+#!/bin/bash
+#
+# Build Fuzix RL02 disk image for STENSAT PDP-11/20 FPGA
+#
+# Produces two images:
+#   fuzix_rl02.dsk     — raw 256-byte sectors (SIMH compatible)
+#   fuzix_rl02_sd.dsk  — expanded 512-byte SD sectors (256 data + 256 × 0xFF pad)
+#
+# Disk layout (in RL02 sectors of 256 bytes):
+#   Sectors  0-3       Boot block (1024 bytes, ROM loads to address 0)
+#   Sectors  4-127     Kernel image
+#   Sectors  128-16383 Root filesystem (~8 MB)
+#   Sectors  16384-20479 Swap partition (~2 MB)
+#
+
+set -e
+
+SCRIPTDIR="$(cd "$(dirname "$0")" && pwd)"
+FUZIXDIR="$(cd "$SCRIPTDIR/../../.." && pwd)"
+TOOLDIR="$FUZIXDIR/Standalone"
+KERNBIN="$FUZIXDIR/Kernel/fuzix.bin"
+
+# RL02 geometry
+SECTOR_SIZE=256
+TOTAL_SECTORS=40960   # 512 cyl × 2 heads × 40 sectors
+
+# Partition layout (in RL02 sectors)
+BOOT_START=0
+BOOT_SECTORS=4        # 1024 bytes
+KERN_START=4
+KERN_RESERVED=252     # sectors 4-255 (64KB max kernel)
+FS_START=256
+FS_SECTORS=16128      # sectors 256-16383
+SWAP_START=16384
+SWAP_SECTORS=4096     # sectors 16384-20479
+
+# Filesystem parameters
+FS_INODES=64          # 64 inode blocks × 8 inodes/block = 512 inodes
+FS_BLOCKS=$((FS_SECTORS / 2))  # Fuzix 512-byte blocks
+
+RAW_IMG="$SCRIPTDIR/fuzix_rl02.dsk"
+SD_IMG="$SCRIPTDIR/fuzix_rl02_sd.dsk"
+FSIMG="$SCRIPTDIR/fuzix_rootfs.img"
+
+echo "=== Fuzix RL02 Disk Image Builder ==="
+echo ""
+
+# --- Check prerequisites ---
+if [ ! -f "$KERNBIN" ]; then
+    echo "ERROR: Kernel not found: $KERNBIN"
+    echo "  Build: cd $FUZIXDIR/Kernel && make TARGET=pdp11dec"
+    exit 1
+fi
+
+if [ ! -f "$TOOLDIR/mkfs" ]; then
+    echo "ERROR: mkfs not found. Build: cd $TOOLDIR && make"
+    exit 1
+fi
+
+# --- Cross-compile settings ---
+CC=pdp11-aout-gcc
+LD=pdp11-aout-ld
+OBJCOPY=pdp11-aout-objcopy
+SIZE=pdp11-aout-size
+LIBDIR="$FUZIXDIR/Library/libs"
+INCDIR="$FUZIXDIR/Library/include"
+CFLAGS="-fno-strict-aliasing -fomit-frame-pointer -fno-builtin -msoft-float -Os -I$INCDIR -I$INCDIR/pdp11"
+LDFLAGS="-L$LIBDIR -lcpdp11 -lgcc $($CC -print-libgcc-file-name) -T$SCRIPTDIR/user.ld"
+CRT0="$LIBDIR/crt0_pdp11.o"
+UTILDIR="$FUZIXDIR/Applications/util"
+BUILDDIR="$SCRIPTDIR/build"
+
+mkdir -p "$BUILDDIR"
+
+# --- Self-heal userland build prerequisites (lost to git clean) ---
+# <sys/userstructs.h> is installed from the kernel tree by the
+# Library makefiles; the cross gcc was built --disable-libgcc so its
+# support routines come from gcclib-pdp11.c here.
+if [ ! -f "$INCDIR/sys/userstructs.h" ]; then
+    install -m 0644 "$FUZIXDIR/Kernel/include/userstructs.h" "$INCDIR/sys/"
+fi
+if [ ! -f "$LIBDIR/libgcc.a" ] || [ "$LIBDIR/gcclib-pdp11.c" -nt "$LIBDIR/libgcc.a" ]; then
+    echo "Building libgcc.a (gcclib-pdp11.c)..."
+    $CC $CFLAGS -c "$LIBDIR/gcclib-pdp11.c" -o "$BUILDDIR/gcclib-pdp11.o"
+    rm -f "$LIBDIR/libgcc.a"
+    pdp11-aout-ar rc "$LIBDIR/libgcc.a" "$BUILDDIR/gcclib-pdp11.o"
+fi
+if [ ! -f "$LIBDIR/libcpdp11.a" ] || [ ! -f "$CRT0" ]; then
+    echo "Building pdp11 C library..."
+    (cd "$FUZIXDIR/Library" && make tools/syscall_pdp11)
+    (cd "$LIBDIR" && make -f Makefile.pdp11)
+fi
+
+# Helper: build a C program into a Fuzix binary
+build_util() {
+    local name="$1"
+    shift
+    local srcs="$@"
+    local objs=""
+    for src in $srcs; do
+        local base=$(basename "$src" .c)
+        $CC $CFLAGS -c "$src" -o "$BUILDDIR/$base.o"
+        objs="$objs $BUILDDIR/$base.o"
+    done
+    $LD $CRT0 $objs -o "$BUILDDIR/$name" $LDFLAGS
+    echo "  $name: $($SIZE "$BUILDDIR/$name" | tail -1 | awk '{print $4}') bytes"
+}
+
+# Helper: convert a.out to Fuzix binary format (via flat binary)
+make_fuz() {
+    $OBJCOPY -O binary "$BUILDDIR/$1" "$BUILDDIR/$1.bin"
+    python3 "$SCRIPTDIR/make_fuzix_bin.py" "$BUILDDIR/$1.bin" "$BUILDDIR/$1.fuz" 2000
+}
+
+# --- Build /init ---
+echo "Building init..."
+build_util init "$SCRIPTDIR/init.c"
+make_fuz init
+
+# --- Build userspace utilities ---
+echo "Building utilities..."
+for prog in ssh cat echo pwd mkdir rmdir chmod hi \
+            true false yes basename dirname sleep whoami uname printenv \
+            head tee wc tr rm kill id chown chgrp uniq more tail od \
+            dd df du mount umount sync remount uptime \
+            rx sx cksum \
+            cp grep sed sort ps free date touch cmp cut ed env stty sum \
+            tar which xargs seq cal factor killall mknod reboot setdate su \
+            passwd who write sync logname groups fgrep uud uue banner \
+            mkfifo; do
+    build_util $prog "$UTILDIR/$prog.c"
+    make_fuz $prog
+    EXTRA_BINS="$EXTRA_BINS $prog"
+done
+
+# --- V7 Bourne shell: pipes, redirection, scripts ---
+SHDIR="$FUZIXDIR/Applications/V7/cmd/sh"
+echo "Building sh (V7)..."
+build_util sh $(for f in args blok builtin cmd ctype error expand fault io \
+    macro main msg name print service setbrk stak string word xec glob; do
+    echo "$SHDIR/$f.c"; done)
+make_fuz sh
+EXTRA_BINS="$EXTRA_BINS sh"
+# Minimal ls (upstream ls.c is too large for 16KB)
+echo "Building ls (minimal)..."
+build_util ls "$UTILDIR/ls.c"
+make_fuz ls
+
+# --- Colossal Cave Adventure (needs the 48KB user space) ---
+# ~27KB binary (text+data) loading at 0x2000 — first program to need
+# the grown map.  The location/message text lives in advent.db,
+# generated by the HOST advgen tool; pdp11 is little-endian 16-bit so
+# no ENDIAN flag (-x is for the big-endian targets; the db uses only
+# uint16_t offsets, so PDP middle-endian never enters into it).
+# adventdb.c's big text block is #if 0'd — only the vocab table
+# compiles into the target binary.
+CAVEDIR="$FUZIXDIR/Applications/cave"
+echo "Building Colossal Cave..."
+build_util advent \
+    "$CAVEDIR/advent.c" "$CAVEDIR/adventdb.c" "$CAVEDIR/database.c" \
+    "$CAVEDIR/english.c" "$CAVEDIR/itverb.c" "$CAVEDIR/lib.c" \
+    "$CAVEDIR/saveadv.c" "$CAVEDIR/turn.c" "$CAVEDIR/verb.c" \
+    "$CAVEDIR/global.c"
+make_fuz advent
+cc "$CAVEDIR/advgen.c" -o "$BUILDDIR/advgen"
+"$BUILDDIR/advgen" > "$BUILDDIR/advent.db"
+echo "  advent.db: $(stat -c %s "$BUILDDIR/advent.db") bytes"
+
+# --- ubasic (integer BASIC, Alan Cox's ubasic fork) ---
+# Vendored in Applications/ubasic (see README.pdp11 there for
+# provenance).  ~17KB text+data at 0x2000 — needs the 48KB map like
+# advent.  _itoa/_uitoa come from libc xitoa.c; the interpreter is
+# stdio-free by upstream design.  Examples ride to /usr/lib/basic.
+UBASDIR="$FUZIXDIR/Applications/ubasic"
+echo "Building ubasic..."
+build_util ubasic \
+    "$UBASDIR/ubx.c" "$UBASDIR/ubasic.c" "$UBASDIR/tokenizer.c"
+make_fuz ubasic
+
+# --- sigtest (task #13: caught-signal trampoline validation) ---
+# Self-checking three-phase probe target; tb_sigprobe and the
+# silicon probe grep its needles.  Lives in the platform dir like
+# init.c — it validates this platform's delivery path.
+echo "Building sigtest..."
+build_util sigtest "$SCRIPTDIR/sigtest.c"
+make_fuz sigtest
+
+# --- levee (vi clone, task #16: first full-screen app) ---
+# ANSI variant (minicom is VT102).  screensz() came to libc with
+# this port -- levee called it but no Fuzix libc ever provided it.
+# 42456B total at 0x2000: the biggest binary on the image, ~6.6KB
+# of headroom below 0xE000 for stack.  4KB in-core edit buffer
+# (levee.h SIZE default).
+LEVDIR="$FUZIXDIR/Applications/levee"
+echo "Building levee..."
+SAVED_CFLAGS="$CFLAGS"
+CFLAGS="$CFLAGS -DVT52=0 -DANSI=1"
+build_util levee \
+    "$LEVDIR/beep.c" "$LEVDIR/blockio.c" "$LEVDIR/display.c" \
+    "$LEVDIR/doscall.c" "$LEVDIR/editcor.c" "$LEVDIR/exec.c" \
+    "$LEVDIR/find.c" "$LEVDIR/flexcall.c" "$LEVDIR/gemcall.c" \
+    "$LEVDIR/globals.c" "$LEVDIR/insert.c" "$LEVDIR/main.c" \
+    "$LEVDIR/misc.c" "$LEVDIR/modify.c" "$LEVDIR/move.c" \
+    "$LEVDIR/rmxcall.c" "$LEVDIR/ucsd.c" "$LEVDIR/undo.c" \
+    "$LEVDIR/unixcall.c" "$LEVDIR/wildargs.c"
+CFLAGS="$SAVED_CFLAGS"
+make_fuz levee
+
+# --- Assemble bootloader ---
+echo "Assembling bootloader..."
+PDP11_ASM="${PDP11_ASM:-pdp11_asm.py}"
+$PDP11_ASM "$SCRIPTDIR/boot_fuzix.s" -o "$SCRIPTDIR/boot_fuzix.hex"
+
+# --- Kernel size check ---
+KERN_SIZE=$(stat -c %s "$KERNBIN")
+KERN_SECTORS=$(( (KERN_SIZE + SECTOR_SIZE - 1) / SECTOR_SIZE ))
+echo "Kernel: $KERN_SIZE bytes ($KERN_SECTORS RL02 sectors)"
+
+if [ "$KERN_SECTORS" -gt "$KERN_RESERVED" ]; then
+    echo "ERROR: Kernel too large ($KERN_SECTORS > $KERN_RESERVED sectors)"
+    exit 1
+fi
+
+# --- Update bootloader sector count ---
+# The bootloader has KERN_NSECT as a constant. Verify it matches.
+echo "  (bootloader loads $KERN_SECTORS sectors from sector $KERN_START)"
+
+# --- Create raw RL02 image (256-byte sectors, SIMH format) ---
+echo ""
+echo "Creating raw RL02 image..."
+dd if=/dev/zero of="$RAW_IMG" bs=$SECTOR_SIZE count=$TOTAL_SECTORS status=none
+
+# Write boot block (sectors 0-3, 1024 bytes)
+# Convert assembler hex output to binary
+python3 -c "
+import sys
+lines = open('$SCRIPTDIR/boot_fuzix.hex').readlines()
+out = bytearray()
+for line in lines:
+    s = line.strip()
+    if s:
+        out.append(int(s, 16))
+# Pad to boot block size (4 sectors × 256 bytes = 1024)
+while len(out) < $((BOOT_SECTORS * SECTOR_SIZE)):
+    out.append(0)
+sys.stdout.buffer.write(out[:$((BOOT_SECTORS * SECTOR_SIZE))])
+" | dd of="$RAW_IMG" bs=$SECTOR_SIZE seek=$BOOT_START conv=notrunc status=none
+
+# Write kernel at sector 4
+echo "Writing kernel at sector $KERN_START..."
+dd if="$KERNBIN" of="$RAW_IMG" bs=$SECTOR_SIZE seek=$KERN_START conv=notrunc status=none
+
+# --- Create root filesystem ---
+echo "Creating root filesystem ($FS_BLOCKS Fuzix blocks, $FS_INODES inode blocks)..."
+$TOOLDIR/mkfs "$FSIMG" $FS_INODES $FS_BLOCKS
+
+# Populate with minimal device nodes and directories
+echo "Populating filesystem..."
+# --- Root /etc files ---
+# Static: the root fs is mounted ro, so mount can never rewrite mtab;
+# a canned copy describing the root mount is exactly right.  passwd
+# gives whoami/getpwuid something to answer with; liberror.txt gives
+# strerror its message table.
+cat > "$BUILDDIR/passwd" <<'PWEOF'
+root::0:0:root:/:/bin/sh
+PWEOF
+cat > "$BUILDDIR/group" <<'GREOF'
+root::0:
+GREOF
+cat > "$BUILDDIR/mtab" <<'MTEOF'
+/dev/hd0 / fuzix ro 0 0
+MTEOF
+
+# ucp mknod syntax: mknod <name> <octal_mode> <dev_number>
+#   mode: 020666 = char dev rw-rw-rw-, 060660 = block dev rw-rw----
+#   dev_number: (major << 8) | minor
+#   dev_tab: major 0 = RL02 disk, major 2 = tty, major 4 = sys
+$TOOLDIR/ucp "$FSIMG" <<UCPEOF
+mkdir dev
+chmod 755 dev
+cd /dev
+mknod tty0 020666 512
+mknod tty1 020666 513
+mknod tty2 020666 514
+mknod console 020666 513
+mknod null 020666 1024
+mknod zero 020666 1029
+mknod proc 020666 1025
+mknod hd0 060660 0
+mknod hd1 060660 1
+cd /
+mkdir tmp
+mkdir home
+chmod 1777 tmp
+mkdir bin
+chmod 755 bin
+mkdir etc
+chmod 755 etc
+mkdir usr
+chmod 755 usr
+cd /
+bget $BUILDDIR/init.fuz init
+chmod 755 init
+cd /bin
+bget $BUILDDIR/ssh.fuz ssh
+chmod 755 ssh
+bget $BUILDDIR/cat.fuz cat
+chmod 755 cat
+bget $BUILDDIR/echo.fuz echo
+chmod 755 echo
+bget $BUILDDIR/pwd.fuz pwd
+chmod 755 pwd
+bget $BUILDDIR/mkdir.fuz mkdir
+chmod 755 mkdir
+bget $BUILDDIR/rmdir.fuz rmdir
+chmod 755 rmdir
+bget $BUILDDIR/chmod.fuz chmod
+chmod 755 chmod
+bget $BUILDDIR/hi.fuz hi
+chmod 755 hi
+bget $BUILDDIR/ls.fuz ls
+chmod 755 ls
+bget $BUILDDIR/true.fuz true
+chmod 755 true
+bget $BUILDDIR/false.fuz false
+chmod 755 false
+bget $BUILDDIR/yes.fuz yes
+chmod 755 yes
+bget $BUILDDIR/basename.fuz basename
+chmod 755 basename
+bget $BUILDDIR/dirname.fuz dirname
+chmod 755 dirname
+bget $BUILDDIR/sleep.fuz sleep
+chmod 755 sleep
+bget $BUILDDIR/whoami.fuz whoami
+chmod 755 whoami
+bget $BUILDDIR/uname.fuz uname
+chmod 755 uname
+bget $BUILDDIR/printenv.fuz printenv
+chmod 755 printenv
+bget $BUILDDIR/head.fuz head
+chmod 755 head
+bget $BUILDDIR/tee.fuz tee
+chmod 755 tee
+bget $BUILDDIR/wc.fuz wc
+chmod 755 wc
+bget $BUILDDIR/tr.fuz tr
+chmod 755 tr
+bget $BUILDDIR/rm.fuz rm
+chmod 755 rm
+bget $BUILDDIR/kill.fuz kill
+chmod 755 kill
+bget $BUILDDIR/id.fuz id
+chmod 755 id
+bget $BUILDDIR/chown.fuz chown
+chmod 755 chown
+bget $BUILDDIR/chgrp.fuz chgrp
+chmod 755 chgrp
+bget $BUILDDIR/uniq.fuz uniq
+chmod 755 uniq
+bget $BUILDDIR/more.fuz more
+chmod 755 more
+bget $BUILDDIR/tail.fuz tail
+chmod 755 tail
+bget $BUILDDIR/od.fuz od
+chmod 755 od
+bget $BUILDDIR/dd.fuz dd
+chmod 755 dd
+bget $BUILDDIR/df.fuz df
+chmod 755 df
+bget $BUILDDIR/du.fuz du
+chmod 755 du
+bget $BUILDDIR/mount.fuz mount
+chmod 755 mount
+bget $BUILDDIR/umount.fuz umount
+chmod 755 umount
+bget $BUILDDIR/sync.fuz sync
+chmod 755 sync
+bget $BUILDDIR/remount.fuz remount
+chmod 755 remount
+bget $BUILDDIR/uptime.fuz uptime
+chmod 755 uptime
+bget $BUILDDIR/rx.fuz rx
+chmod 755 rx
+bget $BUILDDIR/sx.fuz sx
+chmod 755 sx
+bget $BUILDDIR/cksum.fuz cksum
+chmod 755 cksum
+bget $BUILDDIR/ubasic.fuz ubasic
+chmod 755 ubasic
+bget $BUILDDIR/sigtest.fuz sigtest
+chmod 755 sigtest
+bget $BUILDDIR/levee.fuz levee
+chmod 755 levee
+$(for b in $EXTRA_BINS; do echo "bget $BUILDDIR/$b.fuz $b"; echo "chmod 755 $b"; done)
+ln cp mv
+ln cp ln
+cd /etc
+bget $BUILDDIR/passwd passwd
+chmod 644 passwd
+bget $BUILDDIR/group group
+chmod 644 group
+bget $BUILDDIR/mtab mtab
+chmod 644 mtab
+cd /usr
+mkdir lib
+chmod 755 lib
+cd /usr/lib
+bget $LIBDIR/liberror.txt liberror.txt
+chmod 644 liberror.txt
+mkdir basic
+chmod 755 basic
+cd /usr/lib/basic
+bget $UBASDIR/examples/demo.bas demo.bas
+chmod 644 demo.bas
+bget $UBASDIR/examples/fib.bas fib.bas
+chmod 644 fib.bas
+cd /usr
+mkdir games
+chmod 755 games
+cd /usr/games
+bget $BUILDDIR/advent.fuz advent
+chmod 755 advent
+mkdir lib
+chmod 755 lib
+cd /usr/games/lib
+bget $BUILDDIR/advent.db advent.db
+chmod 644 advent.db
+exit
+UCPEOF
+
+# Verify filesystem (before endian conversion, while still x86 LE)
+echo "Checking filesystem..."
+$TOOLDIR/fsck -y "$FSIMG" 2>&1 || true
+
+# Convert 32-bit fields from x86 LE to PDP-endian (word-swapped)
+echo "Converting 32-bit fields to PDP-endian..."
+python3 "$SCRIPTDIR/pdp11_endian_fix.py" "$FSIMG"
+
+# Write filesystem into raw image at FS_START
+# mkfs produces 512-byte Fuzix blocks; we need to split into 256-byte RL02 sectors
+echo "Writing filesystem at sector $FS_START..."
+dd if="$FSIMG" of="$RAW_IMG" bs=$SECTOR_SIZE seek=$FS_START conv=notrunc status=none
+
+# --- Create expanded SD image (512-byte sectors, 256 data + 256 × 0xFF) ---
+echo ""
+echo "Creating expanded SD image (0xFF padded)..."
+python3 -c "
+import sys
+data = open('$RAW_IMG', 'rb').read()
+sector_size = 256
+pad = b'\xff' * 256
+out = bytearray()
+for i in range(0, len(data), sector_size):
+    sector = data[i:i+sector_size]
+    out.extend(sector)
+    out.extend(pad)
+sys.stdout.buffer.write(out)
+" > "$SD_IMG"
+
+# --- Clean up temp files ---
+rm -f "$SCRIPTDIR/boot_fuzix.hex"
+rm -rf "$BUILDDIR"
+# Keep $FSIMG for ucp access (ucp can't handle partitioned images)
+
+# --- Summary ---
+echo ""
+echo "=== Done ==="
+echo "  Raw (SIMH):  $RAW_IMG  ($(stat -c %s "$RAW_IMG") bytes)"
+echo "  SD card:     $SD_IMG  ($(stat -c %s "$SD_IMG") bytes)"
+echo ""
+echo "  Boot:        sectors 0-3"
+echo "  Kernel:      sectors $KERN_START-$((KERN_START + KERN_SECTORS - 1)) ($KERN_SIZE bytes)"
+echo "  Filesystem:  sectors $FS_START-$((FS_START + FS_SECTORS - 1)) ($FS_BLOCKS Fuzix blocks)"
+echo "  Swap:        sectors $SWAP_START-$((SWAP_START + SWAP_SECTORS - 1))"
+echo ""
+echo "  SIMH:    pdp11> attach rl0 $RAW_IMG"
+echo "  SD card: dd if=$SD_IMG of=/dev/sdX bs=512"
+echo ""
+echo "  Utilities:   ssh cat echo pwd mkdir rmdir chmod hi ls"
+echo "               true false yes basename dirname sleep whoami uname printenv"
+echo "               head tee wc tr rm kill id chown chgrp uniq more tail od"
+echo "               dd df du mount umount"
+echo "  Games:       /usr/games/advent (Colossal Cave, db in /usr/games/lib)"
+echo "  BASIC:       /bin/ubasic (examples in /usr/lib/basic: demo.bas fib.bas)"
+echo ""
+echo "  To add more binaries, use ucp on the filesystem image:"
+echo "    $TOOLDIR/ucp $FSIMG"
+echo "  Then re-run this script to rebuild the disk images."
diff --git a/Kernel/platform/platform-pdp11dec/config.h b/Kernel/platform/platform-pdp11dec/config.h
new file mode 100644
index 000000000..ce27e607f
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/config.h
@@ -0,0 +1,74 @@
+/* Enable to make ^Z dump the inode table for debug */
+#undef CONFIG_IDUMP
+/* Enable to make ^A drop back into the monitor */
+#undef CONFIG_MONITOR
+/* Profil syscall support (not yet complete) */
+#undef CONFIG_PROFIL
+
+#define CONFIG_SMALL
+#define ALIGNUP(v) (((v) + 1) & ~1)
+
+#define CONFIG_MULTI
+/*
+ * PDP-11 with a DEC MMU (11/23, 11/23+, 11/34, 11/40, 11/73 ...), 18 bit
+ * addressing, up to 248 KB of memory.
+ *
+ * Kernel virtual = physical 0x0000-0xBFFF (pages 0-5, 48 KB).
+ * Kernel page 6 (VA 0xC000) is a movable window (KIPAR6) onto other
+ * physical memory: process udata stashes, fork copies, Ethernet buffers.
+ * Kernel page 7 is the I/O page.
+ *
+ * User processes live in fixed 44 KB banks from physical 0xC000 up, as
+ * many as fit (bank_click[] in main.c, sized at boot): with 248 KB that is
+ * four banks, 0xC000-0x37FFF, and 24 KB above them for the Ethernet
+ * buffers.  Each bank holds the 512 byte udata stash at offset 0 and the
+ * user image (VA 0x2000-0xCDFF) above it.  More processes swap to the
+ * swap area of the RL02.
+ *
+ * The kernel reaches the current process's memory with MFPI/MTPI.
+ */
+#define CONFIG_BANK_FIXED
+#define MAX_MAPS	4
+#define MAP_SIZE	0xAE00U			/* user span per bank */
+#define CONFIG_PARENT_FIRST
+#define CONFIG_BANKS 	1
+#define PROC_SIZE	88			/* 44K bank, 88 * 512 */
+
+#define BANK_CLICKS	0x2C0		/* 44 KB in 64 byte clicks */
+#define BANK0_CLICK	0x300		/* first bank at physical 0xC000 */
+
+#define PTABSIZE	12
+#define ITABSIZE	24	/* In-core inodes */
+#define OFTSIZE		20	/* Open file table */
+
+#define PROGBASE	0x2000UL
+#define PROGLOAD	PROGBASE
+#define PROGTOP		0xCE00UL
+/* The swap image is the whole bank: stash (512B below PROGBASE, its
+   "VA" is 0x1E00) + user span.  (0xCE00-0x1E00)/512 = 88 exactly. */
+#define SWAP_SIZE	88
+#define SWAPBASE	0x1E00UL
+#define SWAPTOP		0xCE00UL
+#define MAX_SWAPS	PTABSIZE
+#define swap_map(x)	((uint8_t *)(x))
+
+#define SWAPDEV		(1)
+
+#define TICKSPERSEC 60   /* Ticks per second — KW11-L line clock */
+
+#define BOOT_TTY (512 + 1)   /* Set this to default device for stdio, stderr */
+                          /* In this case, the default is the first TTY device */
+                            /* Temp FIXME set to serial port for debug ease */
+
+/* We need a tidier way to do this from the loader */
+#define BOOTDEVICE 0x0000 /* Root fs = RL02 minor 0 */
+#define BOOTPARAM "rw"   /* mount root read-write; remount / ro before power-off writes the clean mark */
+#define CMDLINE	NULL	  /* Location of root dev name */
+
+/* Device parameters */
+#define NUM_DEV_TTY 2
+#define TTYDEV   BOOT_TTY /* Device used by kernel for messages, panics */
+#define NBUFS    4        /* Number of block buffers */
+#define NMOUNTS	 1	  /* Number of mounts at a time */
+
+#define plt_copyright() kprintf("PDP-11 updates (c) 2026 Stensat Group LLC in association with Claude Opus 4.6/4.8, and Fable 5\n")
