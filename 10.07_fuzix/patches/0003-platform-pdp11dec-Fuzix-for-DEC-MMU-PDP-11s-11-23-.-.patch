diff --git a/Kernel/platform/platform-pdp11dec/devices.c b/Kernel/platform/platform-pdp11dec/devices.c
new file mode 100644
index 000000000..5a2dc6ca1
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/devices.c
@@ -0,0 +1,43 @@
+#include <kernel.h>
+#include <version.h>
+#include <kdata.h>
+#include <devsys.h>
+#include <tty.h>
+#include <vt.h>
+#include <dev_rl.h>
+#include <devtty.h>
+
+struct devsw dev_tab[] =  /* The device driver switch table */
+{
+// minor    open         close        read      write       ioctl
+// -----------------------------------------------------------------
+  /* 0: /dev/rl		RL02 disk: minor 0=root, minor 1=swap */
+  {  rl_open,       no_close,    rl_read,   rl_write,  no_ioctl },
+  /* 1: /dev/fd		(absent) */
+  {  nxio_open,     no_close,    no_rdwr,   no_rdwr,   no_ioctl },
+  /* 2: /dev/tty	TTY devices */
+  {  pdp_tty_open,     tty_close,   tty_read,  tty_write,  tty_ioctl },
+  /* 3: /dev/lpr	Printer devices */
+  {  no_open,     no_close,   no_rdwr,   no_rdwr,  no_ioctl  },
+  /* 4: /dev/mem etc	System devices (one offs) */
+  {  no_open,      no_close,    sys_read, sys_write, sys_ioctl  },
+  /* Pack to 7 with nxio if adding private devices and start at 8 */
+};
+
+bool validdev(uint16_t dev)
+{
+    /* This is a bit uglier than needed but the right hand side is
+       a constant this way */
+    if(dev > ((sizeof(dev_tab)/sizeof(struct devsw)) << 8) - 1)
+	return false;
+    else
+        return true;
+}
+
+void device_init(void)
+{
+  int i;
+
+  for (i = 1; i <= MAX_SWAPS; i++)
+    swapmap_init(i);
+}
diff --git a/Kernel/platform/platform-pdp11dec/devtty.c b/Kernel/platform/platform-pdp11dec/devtty.c
new file mode 100644
index 000000000..24da46610
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/devtty.c
@@ -0,0 +1,144 @@
+#include <kernel.h>
+#include <kdata.h>
+#include <printf.h>
+#include <stdbool.h>
+#include <devtty.h>
+#include <device.h>
+#include <tty.h>
+
+/* DL11 register layout: base+0 RCSR, +2 RBUF, +4 XCSR, +6 XBUF.
+   Minor 1 is the console SLU, minor 2 the second SLU. */
+static const uint16_t ttybase[NUM_DEV_TTY + 1] = {
+	0,
+	0177560,
+	0176500
+};
+
+/* Status registers are read as words to avoid the GCC pdp11 ASH
+   sign bug with byte shifts */
+#define RCSR(m)  (*(volatile uint16_t *)(ttybase[m]))
+#define RBUF(m)  (*(volatile uint8_t *)(ttybase[m] + 2))
+#define XCSR(m)  (*(volatile uint16_t *)(ttybase[m] + 4))
+#define XBUF(m)  (*(volatile uint8_t *)(ttybase[m] + 6))
+
+static unsigned char tbuf1[TTYSIZ];
+static unsigned char tbuf2[TTYSIZ];
+static uint8_t sleeping;
+
+/* Set by program_vectors: 1 if the second DL11 at 176500 answered */
+extern uint16_t tty2_present;
+/* Set by init_hardware: 1 if the KW11-L register at 177546 answered */
+extern uint16_t kw11_present;
+
+static int tty_absent(uint8_t minor)
+{
+	return minor == 2 && !tty2_present;
+}
+
+int pdp_tty_open(uint_fast8_t minor, uint16_t flag)
+{
+	if (tty_absent(minor)) {
+		udata.u_error = ENODEV;
+		return -1;
+	}
+	return tty_open(minor, flag);
+}
+
+tcflag_t termios_mask[NUM_DEV_TTY + 1] = {
+	0,
+	_CSYS,
+	_CSYS
+};
+
+struct s_queue ttyinq[NUM_DEV_TTY + 1] = {	/* ttyinq[0] is never used */
+	{NULL, NULL, NULL, 0, 0, 0},
+	{tbuf1, tbuf1, tbuf1, TTYSIZ, 0, TTYSIZ / 2},
+	{tbuf2, tbuf2, tbuf2, TTYSIZ, 0, TTYSIZ / 2},
+};
+
+/* Output for the system console (kprintf etc) */
+void kputchar(uint_fast8_t c)
+{
+	if (c == '\n')
+		tty_putc(1, '\r');
+	tty_putc(1, c);
+}
+
+ttyready_t tty_writeready(uint8_t minor)
+{
+	if (tty_absent(minor))
+		return TTY_READY_NOW;
+	if (XCSR(minor) & 0x80)
+		return TTY_READY_NOW;
+	return TTY_READY_SOON;
+}
+
+void tty_putc(uint8_t minor, unsigned char c)
+{
+	/* The DL11 is single-buffered: an XBUF write while a frame is
+	   shifting restarts the transmitter mid-frame.  The core skips
+	   its READY poll in interrupt context (the echo path), so the
+	   pacing has to live here.  READY clears in the same cycle as
+	   the XBUF write, so this spin is race-free. */
+	if (tty_absent(minor))
+		return;
+	while (!(XCSR(minor) & 0x80));
+	XBUF(minor) = c;
+}
+
+void tty_setup(uint_fast8_t minor, uint_fast8_t flags)
+{
+}
+
+int tty_carrier(uint8_t minor)
+{
+	return 1;
+}
+
+void tty_sleeping(uint8_t minor)
+{
+	sleeping |= 1 << minor;
+}
+
+void tty_data_consumed(uint8_t minor)
+{
+}
+
+/* RX interrupt entry (vectors 060/0300, BR4, shared stub in pdp11.S).
+   The trap_ctrl pending bit is edge-detected on IE&DONE, so a byte
+   arriving while DONE is still set makes no new edge — drain with a
+   loop.  A spurious re-entry just finds DONE clear and returns. */
+void tty_rx_interrupt(void)
+{
+	uint8_t minor;
+	for (minor = 1; minor <= NUM_DEV_TTY; minor++)
+		while (!tty_absent(minor) && (RCSR(minor) & 0x80))
+			tty_inproc(minor, RBUF(minor));
+}
+
+/* Run off the timer: TX wake only, RX is interrupt-driven */
+void tty_interrupt(void)
+{
+	uint8_t minor;
+	for (minor = 1; minor <= NUM_DEV_TTY; minor++) {
+		if (tty_absent(minor))
+			continue;
+		if ((sleeping & (1 << minor)) && (XCSR(minor) & 0x80)) {
+			tty_outproc(minor);
+			sleeping &= ~(1 << minor);
+		}
+	}
+}
+
+void plt_interrupt(void)
+{
+	/* Re-arm the KW11-L: writing the CSR clears the MONITOR bit
+	   (keeping IE).  The FPGA clock request is level ie&monitor
+	   with edge-detected pending in trap_ctrl — without this
+	   write the line never falls and only ONE clock interrupt
+	   is ever delivered. */
+	if (kw11_present)
+		*(volatile uint16_t *)0177546 = 0x40;
+	timer_interrupt();
+	tty_interrupt();
+}
