diff --git a/Kernel/platform/platform-pdp11dec/tricks.S b/Kernel/platform/platform-pdp11dec/tricks.S
new file mode 100644
index 000000000..1c21d2d30
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/tricks.S
@@ -0,0 +1,389 @@
+#include "../../cpu-pdp11/kernel-pdp11.def"
+
+	.text
+
+	.globl _switchin
+	.globl _plt_switchout
+	.globl _preempt_switchout
+	.globl _dofork
+
+/*
+ * Campaign B: two resident 44KB banks (mm/bankfixed.c) + swap
+ * overflow.  Reference flow: Kernel/lib/z80fixedbank-core.s.
+ *
+ * Each process's bank holds a 512-byte udata STASH at offset 0
+ * (below the user image).  The stash is the complete kernel-side
+ * state: the udata struct AND the kernel stack (kstack top is
+ * _udata+512; switch/fork frames live inside the block).  Copying
+ * 256 words through the KIPAR5 window replaces the old 49KB swap
+ * of the whole process — a resident switch is 6 PAR writes and a
+ * 512-byte copy.
+ *
+ * Bank n starts at physical bank_click[n] (main.c).  The kernel
+ * reaches it through the KIPAR6 window at VA 0xC000; the udata
+ * stash is the first 512 bytes of the window.
+ */
+
+_plt_switchout:
+	bis $0340,*$0177776
+	clr -(sp)
+	mov r5,-(sp)
+	mov r4,-(sp)
+	mov r3,-(sp)
+	mov r2,-(sp)
+	mov r1,-(sp)
+#ifndef CONFIG_PDP11_04
+	PUSH_USP
+#endif
+	mov sp,_udata+U_DATA__U_SP
+
+	/* Stash the live udata (struct + kstack, this frame included)
+	   into our own bank so a later switchin — or a swapout of us
+	   while we sleep — finds current state.  IPL is 7. */
+	mov _udata+U_DATA__U_PAGE,r0
+	beq 1f			/* no bank (paranoia): nothing to stash */
+	jsr pc,stash_write
+1:
+	jsr pc,_getproc
+	mov r0,-(sp)
+	jsr pc,_switchin
+	jmp _plt_monitor
+
+/*
+ * preempt_switchout (task #12): called from the clock-ISR exit when
+ * returning to USER mode with need_resched set.  Same shape as
+ * plt_switchout with ONE deliberate difference: plt_switchout CLEARS
+ * the r0 frame slot (the syscall return-value convention — r0 is
+ * rebuilt from u_retval on the way out), but a preempted process
+ * gets NO new r0 — it resumes mid-computation, so the REAL r0 must
+ * ride the frame.  switchin's restore sequence is shape-agnostic
+ * about the slot's value, so both flavors share the same exit.
+ *
+ * On resume: rts pc back into the clock glue, whose rti consumes
+ * the original trap frame — the user continues where the tick hit.
+ */
+_preempt_switchout:
+	bis $0340,*$0177776
+	mov r0,-(sp)		/* REAL r0 — see above */
+	mov r5,-(sp)
+	mov r4,-(sp)
+	mov r3,-(sp)
+	mov r2,-(sp)
+	mov r1,-(sp)
+#ifndef CONFIG_PDP11_04
+	PUSH_USP
+#endif
+	mov sp,_udata+U_DATA__U_SP
+
+	/* Frame is safe: deliver pending signals now.  Default-fatal
+	   dispositions (a spinner's ^C) doexit inside and never come
+	   back — this is what makes compute loops interruptible at
+	   tick latency instead of next-syscall latency. */
+	jsr pc,_chksigs
+
+	/* Unlike a voluntary switchout — where the caller has already
+	   moved us off P_RUNNING before calling — a PREEMPTED process
+	   is still P_RUNNING here.  getproc panics ("extra running")
+	   if it walks the ptab and finds a runner, so transition
+	   ourselves to P_READY now.  Also set PFL_BATCH: getproc skips
+	   a batch-flagged process one round (clearing the flag), so a
+	   compute hog yields a turn instead of being re-picked
+	   immediately — the fairness penalty, straight from the z80
+	   fixedbank preemption model.  Skip if chksigs already changed
+	   our state (P_STOPPED, or torn down by a fatal signal). */
+	mov _udata,r0			/* u_ptab (offset 0) = our ptab */
+	cmpb $1,P_TAB__P_STATUS_OFFSET(r0)	/* still P_RUNNING? */
+	bne 3f
+	movb $2,P_TAB__P_STATUS_OFFSET(r0)	/* -> P_READY */
+	bisb $4,P_TAB__P_FLAGS_OFFSET(r0)	/* PFL_BATCH */
+3:
+	/* Stash + schedule, exactly as plt_switchout */
+	mov _udata+U_DATA__U_PAGE,r0
+	beq 1f
+	jsr pc,stash_write
+1:
+	jsr pc,_getproc
+	mov r0,-(sp)
+	jsr pc,_switchin
+	jmp _plt_monitor
+
+_switchin:
+	bis $0340,*$0177776
+	mov 2(sp),r0		/* incoming ptab ptr — grab it BEFORE
+				   leaving the caller's stack */
+	/* ALWAYS run switchin on the dedicated swap stack.  The
+	   resident path below copies the incoming stash OVER the live
+	   udata block — which contains the outgoing kernel stack.  Any
+	   word we push there (the saved ptab ptr) would be replaced by
+	   the incoming process's stacked data mid-copy and pop back as
+	   garbage.  z80fixedbank-core.s warns about exactly this
+	   ("this was a bitch to debug, please don't break it"); we
+	   re-derived the lesson from a 1701 in the boot log. */
+	mov $swapstack,sp
+	tst P_TAB__P_PAGE_OFFSET(r0)
+	bne resident
+
+	/* Swap path: incoming lives on disk.  _swapper(p) frees a
+	   bank if needed (evicting a victim whose stash is current —
+	   written at its last switchout) and reads the incoming
+	   bank image in.  The disk driver runs the big transfers
+	   with interrupts enabled (dev_rl.c, rawflag 2) so the
+	   console and clock stay alive; everything here therefore
+	   runs on the dedicated swap stack — ISR frames must not
+	   land on a kernel stack that lives inside the udata block —
+	   and under inswap, which tells timer_interrupt not to
+	   trust mid-swap state.  SP is reloaded from the incoming
+	   process's stash below, so the old SP is not saved.  (We are
+	   already on the swap stack — set at entry.) */
+	incb _inswap
+	mov r0,-(sp)
+	mov r0,-(sp)
+	jsr pc,_swapper
+	mov (sp)+,r0
+	mov (sp)+,r0
+	clrb _inswap
+	bis $0340,*$0177776
+	/* p_page now holds the bank swapper chose — fall through */
+
+resident:
+	/* Tormod's optimisation (z80fixedbank): if the incoming
+	   process already owns the live udata, skip the stash load —
+	   the live copy is newer than (or identical to) the stash. */
+	cmp _udata+U_DATA__U_PTAB,r0
+	beq owned
+
+	/* Load the incoming stash: KIPAR6 -> its bank, copy 256
+	   words window -> _udata.  Registers r1-r3 are dead here
+	   (restored from the incoming frame below). */
+	mov r0,-(sp)		/* ptab ptr across the copy */
+	mov P_TAB__P_PAGE_OFFSET(r0),r0
+	jsr pc,bank_window
+	mov $0140000,r1		/* window VA 0xC000 */
+	mov $_udata,r2
+	mov $256,r3
+2:	mov (r1)+,(r2)+
+	dec r3
+	bne 2b
+	mov (sp)+,r0
+
+	/* The stash predates any swap cycle the process went
+	   through: refresh u_page from the ptab truth. */
+	mov P_TAB__P_PAGE_OFFSET(r0),_udata+U_DATA__U_PAGE
+
+	cmp _udata+U_DATA__U_PTAB,r0
+	bne switchfail
+
+owned:
+	movb $P_RUNNING,P_TAB__P_STATUS_OFFSET(r0)
+	/* Point UIPAR1-6 at the incoming bank (reads u_page). */
+	jsr pc,_program_user_map	/* clobbers r0 — done with it */
+	clr _runticks
+	mov _udata+U_DATA__U_SP,sp
+#ifndef CONFIG_PDP11_04
+	POP_USP
+#endif
+	mov (sp)+,r1
+	mov (sp)+,r2
+	mov (sp)+,r3
+	mov (sp)+,r4
+	mov (sp)+,r5
+	mov (sp)+,r0
+	rts pc
+switchfail:
+	jsr pc,outr0hex
+	mov $badswitchmsg,r0
+	jsr pc,outstring
+	jmp _plt_monitor
+
+/*
+ * dofork: the child's bank was already allocated by pagemap_alloc
+ * in ptab_alloc (C side) — including any victim eviction to disk —
+ * so by the time we run, both parent and child own banks.  Build
+ * the child's return frame, stash a child-flavored udata into the
+ * child's bank, then copy the parent's user image bank-to-bank.
+ * The parent returns the child's pid; the child, on its first
+ * switchin, loads the stash and returns 0 from here.
+ */
+_dofork:
+	mov 2(sp),r0
+	mov r0,fork_proc_ptr
+
+	/* Build child's return frame (matches _plt_switchout for
+	   _switchin).  Child will return from _switchin -> dofork
+	   caller with r0 = 0. */
+	clr -(sp)
+	mov r5,-(sp)
+	mov r4,-(sp)
+	mov r3,-(sp)
+	mov r2,-(sp)
+	mov r1,-(sp)
+#ifndef CONFIG_PDP11_04
+	PUSH_USP
+#endif
+	mov sp,_udata+U_DATA__U_SP
+
+	/* Make the live udata claim to be the child (ptab AND bank),
+	   stash it into the CHILD's bank, then restore the parent
+	   identity.  Mask for the stash write: an IRQ mid-copy could
+	   capture a transient u_ininterrupt=1 into the child image,
+	   to be restored as truth on the child's first switchin —
+	   the same hazard the old swap-based dofork masked for. */
+	mov _udata,fork_parent_ptab
+	mov _udata+U_DATA__U_PAGE,fork_parent_page
+	mov *$0177776,fork_psw
+	bis $0340,*$0177776
+	mov r0,_udata
+	mov P_TAB__P_PAGE_OFFSET(r0),_udata+U_DATA__U_PAGE
+	mov P_TAB__P_PAGE_OFFSET(r0),r0
+	jsr pc,stash_write
+	mov fork_parent_ptab,_udata
+	mov fork_parent_page,_udata+U_DATA__U_PAGE
+	mov fork_psw,*$0177776
+
+	/* Copy the parent's user image to the child's bank: 22272
+	   words (43.5K) through both windows, interrupts live.  Safe:
+	   dofork is a syscall (u_insys) so no preemption; ISR-driven
+	   EIS traps are kernel-mode and eis_fetch reads identity for
+	   kernel sources, so neither window moves under us. */
+	jsr pc,bank_copy
+
+	/* Unwind the child's frame, RESTORING r2-r5 for the parent:
+	   gcc treats them as callee-saved across dofork() (_fork
+	   caches &udata in r5 and its saved PSW in r4), but the
+	   pushes above belong to the CHILD's switchin restore and
+	   bank_copy just used r0-r5 as cursors.  Discarding the
+	   frame here returned bank_copy's leftover PAR cursor in r5;
+	   _fork's p_status store then dereferenced it — a wild byte
+	   write whose target is whatever text word sits at 0x588/
+	   0x848 (latent since Campaign B; task13's layout shuffle
+	   made it kernel-text corruption — 2026jul22_sigtramp.md). */
+#ifndef CONFIG_PDP11_04
+	add $2,sp		/* USP word: dofork never moves USP */
+#endif
+	add $2,sp		/* r1: call-clobbered per gcc ABI */
+	mov (sp)+,r2
+	mov (sp)+,r3
+	mov (sp)+,r4
+	mov (sp)+,r5
+	add $2,sp		/* the child's r0=0 word */
+
+	/* makeproc(child_ptab, &_udata) — sets up child ptab entry.
+	   Note: makeproc sets u->u_ptab = p AND u->u_page = p_page,
+	   corrupting the parent's live udata.  Restore both. */
+	mov $_udata,-(sp)
+	mov fork_proc_ptr,-(sp)
+	jsr pc,_makeproc
+	add $4,sp
+	mov fork_parent_ptab,_udata
+	mov fork_parent_page,_udata+U_DATA__U_PAGE
+
+	/* Return child PID to parent */
+	mov fork_proc_ptr,r0
+	mov P_TAB__P_PID_OFFSET(r0),r0
+	clr _runticks
+	rts pc
+
+/*
+ * stash_write: copy the live udata block (256 words) into the bank
+ * whose id is in r0.  Caller holds IPL 7.  Clobbers r0-r3.
+ */
+stash_write:
+	jsr pc,bank_window
+	mov $_udata,r1
+	mov $0140000,r2		/* window VA 0xC000 */
+	mov $256,r3
+1:	mov (r1)+,(r2)+
+	dec r3
+	bne 1b
+	rts pc
+
+/*
+ * bank_window: point KIPAR6 (kernel VA 0xC000) at the base of bank r0.
+ * Clobbers r0.  The window is left there: whoever uses it next sets
+ * it again.  Interrupt handlers must not move it.
+ */
+bank_window:
+	asl r0
+	mov _bank_click(r0),*$0172354
+	rts pc
+
+/*
+ * bank_copy: the parent's user image (VA 0x2000-0xCDFF, 22272 words,
+ * the current user map) to the child's bank at offset 0x200.  Reads
+ * with MFPI, writes through the KIPAR6 window, 8 KB at a time.
+ * Interrupts may be live (see dofork).  Clobbers r0-r5.
+ */
+bank_copy:
+	bis $030000,*$0177776		/* previous mode = user, for MFPI */
+	mov fork_proc_ptr,r0
+	mov P_TAB__P_PAGE_OFFSET(r0),r0	/* child bank */
+	asl r0
+	mov _bank_click(r0),r4
+	add $010,r4			/* PAR of the child's VA 0x2000 */
+	mov $0x2000,r1			/* user VA cursor */
+	mov $6,r5			/* chunks */
+1:	mov r4,*$0172354		/* KIPAR6 = destination chunk */
+	mov $0140000,r2			/* window VA 0xC000 */
+	mov $010000,r3			/* 4096 words = 8 KB */
+	cmp r5,$1
+	bne 2f
+	mov $03400,r3			/* last: 0xE00 bytes = 1792 words */
+2:	mfpi (r1)+
+	mov (sp)+,(r2)+
+	sob r3,2b
+	add $0200,r4
+	sob r5,1b
+	rts pc
+
+/*
+ * uint16_t phys_present(uint16_t click): 1 if there is memory at
+ * physical click * 64 (read through the KIPAR6 window with the bus
+ * error vector caught).
+ */
+	.globl _phys_present
+_phys_present:
+	mov *$4,-(sp)
+	mov *$6,-(sp)
+	mov $pp_nx,*$4
+	mov $0340,*$6
+	mov 6(sp),*$0172354
+	mov $1,r0
+	tst *$0140000
+pp_out:
+	mov (sp)+,*$6
+	mov (sp)+,*$4
+	rts pc
+pp_nx:
+	clr r0
+	mov $pp_out,(sp)	/* resume at pp_out */
+	rti
+
+fork_proc_ptr:	 .word 0
+fork_parent_ptab: .word 0
+fork_parent_page: .word 0
+fork_psw:	 .word 0
+copy_chunks:	 .word 0
+
+badswitchmsg:
+	.ascii "_switchin: FAIL"
+	.byte 13,10,0
+	.even
+	/* Swap runs with interrupts live: worst case a DL11 RX ISR
+	   with the KW11-L clock ISR nested on top of it (BR6 > BR4)
+	   plus an EIS emulation trap, all on top of the swapper's own
+	   C call chain.  256 was fine when swap ran masked; it is not
+	   safe headroom now. */
+	.= .+512
+swapstack:
+
+/* uint16_t get_usp(void), void set_usp(uint16_t): the user mode SP */
+	.globl _get_usp
+	.globl _set_usp
+_get_usp:
+	PUSH_USP
+	mov (sp)+,r0
+	rts pc
+_set_usp:
+	mov 2(sp),-(sp)
+	POP_USP
+	rts pc
diff --git a/Kernel/platform/platform-pdp11dec/user.ld b/Kernel/platform/platform-pdp11dec/user.ld
new file mode 100644
index 000000000..0f2db67ea
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/user.ld
@@ -0,0 +1,51 @@
+/*
+ * Linker script for Fuzix PDP-11 userspace binaries.
+ *
+ * Code is linked at PROGBASE = 0x2000.
+ * The crt0 header occupies the first 16 bytes (replaced by exec header on disk,
+ * overwritten by sys_stubs at load time). __start2 at 0x2010 is the entry point.
+ * PROGTOP = 0xE000, so max code+data+bss = ~48KB.
+ */
+OUTPUT_FORMAT("a.out-pdp11", "a.out-pdp11", "a.out-pdp11")
+OUTPUT_ARCH(pdp11)
+PROVIDE (__stack = 0);
+
+SECTIONS
+{
+  . = 0x2000;
+  .text :
+  {
+    CREATE_OBJECT_SYMBOLS
+    *(.text)
+    *(.dynrel)
+    *(.hash)
+    *(.dynsym)
+    *(.dynstr)
+    *(.rules)
+    *(.need)
+    _etext = .;
+    __etext = .;
+    . = ALIGN(2);
+  }
+  .data :
+  {
+    *(.dynamic)
+    *(.got)
+    *(.plt)
+    *(.data)
+    *(.linux-dynamic)
+    CONSTRUCTORS
+    _edata  =  .;
+    __edata  =  .;
+    . = ALIGN(2);
+  }
+  .bss :
+  {
+    __bss_start = .;
+   *(.bss)
+   *(COMMON)
+   . = ALIGN(2);
+   _end = . ;
+   __end = . ;
+  }
+}
diff --git a/Kernel/platform/platform-pdp11dec/usermem_mfpi.S b/Kernel/platform/platform-pdp11dec/usermem_mfpi.S
new file mode 100644
index 000000000..376c635df
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/usermem_mfpi.S
@@ -0,0 +1,188 @@
+/*
+ * User memory access with MFPI/MTPI.
+ *
+ * The user map (UIPARs) always describes the current process, so the
+ * kernel reads and writes its memory with MFPI/MTPI, previous mode set
+ * to user.  Word copies when both addresses are even, otherwise byte by
+ * byte (a byte write is a read-modify-write of the user word).
+ *
+ * The callers (Kernel/usermem.c) have checked the addresses.
+ * gcc calling convention: arguments at 2(sp), 4(sp) ..., r0-r1 scratch.
+ * Offsets are decimal (GNU as).
+ */
+#include "../../cpu-pdp11/kernel-pdp11.def"
+
+	.text
+	.globl	__uget, __uput, __uzero
+	.globl	__ugetc, __ugetw, __uputc, __uputw
+
+/*
+ * Previous mode = user, and make sure the user map is the current
+ * process's: the kernel touches a new process's memory (create_init,
+ * exec) before it has run, so before switchin loaded its map.
+ * Clobbers r0.
+ */
+	.macro	PREV_USER
+	bis	$030000,*$0177776
+	cmp	_udata+U_DATA__U_PAGE,_umap_page
+	beq	.+6
+	jsr	pc,_program_user_map
+	.endm
+
+/* int _uget(const uint8_t *user, uint8_t *dest, usize_t count) */
+__uget:
+	mov	r2,-(sp)
+	mov	r3,-(sp)
+	PREV_USER
+	mov	6(sp),r0		/* user */
+	mov	8(sp),r1		/* dest */
+	mov	10(sp),r2		/* count */
+	beq	9f
+	bit	$1,r0
+	bne	3f
+	bit	$1,r1
+	bne	3f
+	mov	r2,r3
+	clc
+	ror	r3			/* words */
+	beq	2f
+1:	mfpi	(r0)+
+	mov	(sp)+,(r1)+
+	sob	r3,1b
+2:	bic	$0177776,r2		/* odd byte left? */
+	beq	9f
+3:	mov	r0,r3			/* byte loop */
+	bic	$1,r3
+	mfpi	(r3)
+	bit	$1,r0
+	beq	4f
+	movb	1(sp),(r1)+
+	br	5f
+4:	movb	(sp),(r1)+
+5:	tst	(sp)+
+	inc	r0
+	sob	r2,3b
+9:	clr	r0
+	mov	(sp)+,r3
+	mov	(sp)+,r2
+	rts	pc
+
+/* int _uput(const uint8_t *source, uint8_t *user, usize_t count) */
+__uput:
+	mov	r2,-(sp)
+	mov	r3,-(sp)
+	PREV_USER
+	mov	6(sp),r0		/* source */
+	mov	8(sp),r1		/* user */
+	mov	10(sp),r2		/* count */
+	beq	9f
+	bit	$1,r0
+	bne	3f
+	bit	$1,r1
+	bne	3f
+	mov	r2,r3
+	clc
+	ror	r3
+	beq	2f
+1:	mov	(r0)+,-(sp)
+	mtpi	(r1)+
+	sob	r3,1b
+2:	bic	$0177776,r2
+	beq	9f
+3:	mov	r1,r3
+	bic	$1,r3
+	mfpi	(r3)
+	bit	$1,r1
+	beq	4f
+	movb	(r0)+,1(sp)
+	br	5f
+4:	movb	(r0)+,(sp)
+5:	mtpi	(r3)
+	inc	r1
+	sob	r2,3b
+9:	clr	r0
+	mov	(sp)+,r3
+	mov	(sp)+,r2
+	rts	pc
+
+/* int _uzero(uint8_t *user, usize_t count) */
+__uzero:
+	mov	r2,-(sp)
+	mov	r3,-(sp)
+	PREV_USER
+	mov	6(sp),r1		/* user */
+	mov	8(sp),r2		/* count */
+	beq	9f
+	bit	$1,r1
+	bne	3f
+	mov	r2,r3
+	clc
+	ror	r3
+	beq	2f
+1:	clr	-(sp)
+	mtpi	(r1)+
+	sob	r3,1b
+2:	bic	$0177776,r2
+	beq	9f
+3:	mov	r1,r3
+	bic	$1,r3
+	mfpi	(r3)
+	bit	$1,r1
+	beq	4f
+	clrb	1(sp)
+	br	5f
+4:	clrb	(sp)
+5:	mtpi	(r3)
+	inc	r1
+	sob	r2,3b
+9:	clr	r0
+	mov	(sp)+,r3
+	mov	(sp)+,r2
+	rts	pc
+
+/* int16_t _ugetc(const uint8_t *user) */
+__ugetc:
+	PREV_USER
+	mov	2(sp),r1
+	mov	r1,r0
+	bic	$1,r0
+	mfpi	(r0)
+	mov	(sp)+,r0
+	bit	$1,r1
+	beq	1f
+	swab	r0
+1:	bic	$0177400,r0
+	rts	pc
+
+/* uint16_t _ugetw(const uint16_t *user) */
+__ugetw:
+	PREV_USER
+	mov	2(sp),r0
+	mfpi	(r0)
+	mov	(sp)+,r0
+	rts	pc
+
+/* int _uputc(uint16_t value, uint8_t *user) */
+__uputc:
+	PREV_USER
+	mov	4(sp),r1
+	mov	r1,r0
+	bic	$1,r0
+	mfpi	(r0)
+	bit	$1,r1
+	beq	1f
+	movb	4(sp),1(sp)		/* value: 2(sp) + the pushed word */
+	br	2f
+1:	movb	4(sp),(sp)
+2:	mtpi	(r0)
+	clr	r0
+	rts	pc
+
+/* int _uputw(uint16_t value, uint16_t *user) */
+__uputw:
+	PREV_USER
+	mov	4(sp),r0
+	mov	2(sp),-(sp)
+	mtpi	(r0)
+	clr	r0
+	rts	pc
