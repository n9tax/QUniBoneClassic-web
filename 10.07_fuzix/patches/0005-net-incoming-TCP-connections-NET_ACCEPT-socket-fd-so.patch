+/* Read the request head: returns its length, or -1 */
+static int read_request(int fd)
+{
+	int n = 0, k;
+	while (n < (int)sizeof(buf) - 1) {
+		k = read(fd, buf + n, sizeof(buf) - 1 - n);
+		if (k <= 0)
+			return n ? n : -1;
+		n += k;
+		buf[n] = 0;
+		if (strstr(buf, "\r\n\r\n") || strstr(buf, "\n\n"))
+			break;
+	}
+	buf[n] = 0;
+	return n;
+}
 
+static void serve(int fd)
+{
+	char path[128];
+	char *method, *url, *p;
+	struct stat st;
+	int head, f, n;
 
+	if (read_request(fd) < 0)
+		return;
+	method = strtok(buf, " ");
+	url = strtok(NULL, " \r\n");
+	if (method == NULL || url == NULL) {
+		error(fd, "400 Bad Request");
+		return;
+	}
+	head = !strcmp(method, "HEAD");
+	if (!head && strcmp(method, "GET")) {
+		error(fd, "501 Not Implemented");
+		return;
+	}
+	if ((p = strchr(url, '?')) != NULL)
+		*p = 0;
+	if (url[0] != '/' || strstr(url, "..")) {
+		error(fd, "400 Bad Request");
+		return;
+	}
+	snprintf(path, sizeof(path), "%s%s", root, url);
+	if (stat(path, &st) == 0 && S_ISDIR(st.st_mode)) {
+		n = strlen(path);
+		snprintf(path + n, sizeof(path) - n, "%sindex.html",
+			path[n - 1] == '/' ? "" : "/");
+	}
+	if (stat(path, &st) < 0 || !S_ISREG(st.st_mode) ||
+	    (f = open(path, O_RDONLY)) < 0) {
+		error(fd, "404 Not Found");
+		return;
+	}
+	reply(fd, "200 OK", type_of(path), st.st_size);
+	if (!head)
+		while ((n = read(f, buf, sizeof(buf))) > 0)
+			if (write(fd, buf, n) != n)
+				break;
+	close(f);
 }
 
+int main(int argc, char *argv[])
+{
+	struct sockaddr_in addr;
+	int lfd, fd;
 
+	if (argc > 2)
+		root = argv[2];
+	memset(&addr, 0, sizeof(addr));
+	addr.sin_family = AF_INET;
+	addr.sin_port = htons(argc > 1 ? atoi(argv[1]) : 80);
+	lfd = socket(AF_INET, SOCK_STREAM, 0);
+	if (lfd < 0) {
+		perror("httpd: socket");
+		return 1;
+	}
+	if (bind(lfd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+		perror("httpd: bind");
+		return 1;
+	}
+	if (listen(lfd, 2) < 0) {
+		perror("httpd: listen");
+		return 1;
+	}
+	signal(SIGPIPE, SIG_IGN);
+	for (;;) {
+		fd = accept(lfd, NULL, NULL);
+		if (fd < 0) {
+			if (errno != EINTR)
+				sleep(1);
+			continue;
+		}
+		serve(fd);
+		close(fd);
+	}
+}
