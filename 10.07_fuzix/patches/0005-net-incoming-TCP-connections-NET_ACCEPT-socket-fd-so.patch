+/*
+ *	The daemon has accepted a connection for a listening socket: make
+ *	a socket for it, already connected, for accept() to collect.
+ */
+static int netn_accept(char *data)
+{
+	struct netaccept na;
+	struct socket *ls, *ns;
+	struct sockdata *sd;
+	uint8_t i;
+
+	if (uget(data, &na, sizeof(na)))
+		return -1;
+	ls = sockets + na.listener;
+	if (na.listener >= NSOCKET || ls->s_state != SS_LISTENING) {
+		udata.u_error = EINVAL;
+		return -1;
+	}
+	for (i = 0; i < NSOCKET; i++)
+		if (!sockdata[i].socket)
+			break;
+	if (i == NSOCKET) {
+		udata.u_error = ENOBUFS;
+		return -1;
+	}
+	ns = sockets + i;
+	sd = sockdata + i;
+	memset(sd, 0, sizeof(*sd));
+	sd->socket = ns;
+	sd->lcn = na.lcn;
+	memcpy(ns, ls, sizeof(*ns));
+	ns->s_num = i;
+	ns->s_state = SS_CONNECTED;
+	ns->s_iflags = 0;
+	ns->s_ino = NULL;
+	ns->dst_addr.sa.sin.sin_port = na.port;
+	ns->dst_addr.sa.sin.sin_addr.s_addr = na.addr;
+	ns->dst_len = sizeof(struct sockaddr_in);
+	ns->s_parent = na.listener;
+	wakeup_all(ls);
+	return i;
+}
