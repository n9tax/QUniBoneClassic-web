diff --git a/Applications/netd/telnetd.c b/Applications/netd/telnetd.c
new file mode 100644
index 000000000..dc1e85719
--- /dev/null
+++ b/Applications/netd/telnetd.c
@@ -0,0 +1,317 @@
+/*
+ * telnetd - a small telnet server for Fuzix: logs a user in over TCP
+ * port 23 and runs their shell.
+ *
+ * Fuzix has no pseudo terminals here, so the shell talks to pipes and a
+ * relay process sits between them and the connection:
+ *
+ *   network -> relay: telnet commands removed, CR LF and CR NUL become
+ *              a newline, IAC IP (^C at the client) and IAC BRK send
+ *              SIGINT to the shell's process group
+ *   shell -> network: newlines become CR LF
+ *
+ * The client keeps its default line mode: it echoes and edits lines
+ * itself, which is what a shell reading a pipe needs.  The relay polls
+ * both sides (no select() in this kernel), with a short sleep when idle.
+ *
+ * telnetd [port]   default 23.  Run it in the background from /etc/rc.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <signal.h>
+#include <pwd.h>
+#include <sys/wait.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+
+#define IAC	255
+#define DONT	254
+#define DO	253
+#define WONT	252
+#define WILL	251
+#define SB	250
+#define BRK	243
+#define IP	244
+#define SE	240
+
+static int net;			/* the connection */
+static int shell_pid;
+
+static void netputs(const char *s)
+{
+	write(net, s, strlen(s));
+}
+
+/* Write shell output to the network, newline -> CR LF */
+static void to_net(const char *p, int n)
+{
+	char out[256];
+	int o = 0;
+	while (n--) {
+		char c = *p++;
+		if (c == '\n')
+			out[o++] = '\r';
+		else if ((unsigned char)c == IAC)
+			out[o++] = (char)IAC;	/* escape it */
+		out[o++] = c;
+		if (o >= (int)sizeof(out) - 2) {
+			write(net, out, o);
+			o = 0;
+		}
+	}
+	if (o)
+		write(net, out, o);
+}
+
+/* Network input state machine: telnet commands, line ends */
+static int tstate;
+#define TS_DATA	0
+#define TS_IAC	1
+#define TS_OPT	2
+#define TS_SB	3
+#define TS_SBIAC 4
+#define TS_CR	5
+
+/* Returns the number of bytes for the shell left in out[] */
+static int from_net(const unsigned char *p, int n, char *out)
+{
+	int o = 0;
+	while (n--) {
+		unsigned char c = *p++;
+		switch (tstate) {
+		case TS_IAC:
+			tstate = TS_DATA;
+			if (c >= WILL && c <= DONT)
+				tstate = TS_OPT;
+			else if (c == SB)
+				tstate = TS_SB;
+			else if (c == IP || c == BRK) {
+				if (shell_pid > 0)
+					kill(-shell_pid, SIGINT);
+			} else if (c == IAC)
+				out[o++] = (char)c;
+			continue;
+		case TS_OPT:		/* we agree to nothing */
+			tstate = TS_DATA;
+			continue;
+		case TS_SB:
+			if (c == IAC)
+				tstate = TS_SBIAC;
+			continue;
+		case TS_SBIAC:
+			tstate = c == SE ? TS_DATA : TS_SB;
+			continue;
+		case TS_CR:
+			tstate = TS_DATA;
+			if (c == '\n' || c == 0)
+				continue;	/* CR LF, CR NUL: one newline */
+			break;
+		}
+		if (c == IAC) {
+			tstate = TS_IAC;
+			continue;
+		}
+		if (c == '\r') {
+			out[o++] = '\n';
+			tstate = TS_CR;
+			continue;
+		}
+		if (c == 3 && shell_pid > 0) {	/* ^C sent as a character */
+			kill(-shell_pid, SIGINT);
+			continue;
+		}
+		out[o++] = c;
+	}
+	return o;
+}
+
+/* Read a line from the network (for the login prompt), no echo control */
+static int getline_net(char *buf, int len)
+{
+	unsigned char in[64];
+	char tmp[64];
+	int n = 0, i, k;
+	for (;;) {
+		k = read(net, in, sizeof(in));
+		if (k <= 0)
+			return -1;
+		k = from_net(in, k, tmp);
+		for (i = 0; i < k; i++) {
+			if (tmp[i] == '\n') {
+				buf[n] = 0;
+				return n;
+			}
+			if (n < len - 1)
+				buf[n++] = tmp[i];
+		}
+	}
+}
+
+/* Check the user against /etc/passwd; empty password: no question */
+static struct passwd *login(void)
+{
+	char name[32], pass[64];
+	struct passwd *pw;
+	int tries;
+
+	for (tries = 0; tries < 3; tries++) {
+		netputs("login: ");
+		if (getline_net(name, sizeof(name)) < 0)
+			return NULL;
+		if (!name[0])
+			continue;
+		pw = getpwnam(name);
+		if (pw && !pw->pw_passwd[0])
+			return pw;
+		netputs("Password: ");
+		if (getline_net(pass, sizeof(pass)) < 0)
+			return NULL;
+		if (pw && !strcmp(crypt(pass, pw->pw_passwd), pw->pw_passwd))
+			return pw;
+		netputs("Login incorrect\r\n");
+	}
+	return NULL;
+}
+
+static void session(void)
+{
+	int tosh[2], fromsh[2];
+	unsigned char in[128];
+	char buf[256];
+	struct passwd *pw;
+	int n, idle;
+	char *shell;
+	static char env_home[64], env_user[40];
+	char *envp[5];
+	char *argv[2];
+
+	netputs("\r\nFuzix on a PDP-11\r\n\r\n");
+	pw = login();
+	if (pw == NULL)
+		exit(1);
+
+	if (pipe(tosh) < 0 || pipe(fromsh) < 0) {
+		netputs("telnetd: no pipes\r\n");
+		exit(1);
+	}
+	shell_pid = fork();
+	if (shell_pid < 0) {
+		netputs("telnetd: cannot fork\r\n");
+		exit(1);
+	}
+	if (shell_pid == 0) {
+		setpgrp();
+		dup2(tosh[0], 0);
+		dup2(fromsh[1], 1);
+		dup2(fromsh[1], 2);
+		close(tosh[0]);
+		close(tosh[1]);
+		close(fromsh[0]);
+		close(fromsh[1]);
+		close(net);
+		setgid(pw->pw_gid);
+		setuid(pw->pw_uid);
+		chdir(pw->pw_dir);
+		snprintf(env_home, sizeof(env_home), "HOME=%s", pw->pw_dir);
+		snprintf(env_user, sizeof(env_user), "USER=%s", pw->pw_name);
+		envp[0] = "PATH=/bin:/usr/bin";
+		envp[1] = env_home;
+		envp[2] = env_user;
+		envp[3] = "TERM=dumb";
+		envp[4] = NULL;
+		shell = pw->pw_shell[0] ? pw->pw_shell : "/bin/sh";
+		/* "-sh" would read a profile; plain sh, interactive */
+		argv[0] = "sh";
+		argv[1] = NULL;
+		execve(shell, argv, envp);
+		_exit(127);
+	}
+	close(tosh[0]);
+	close(fromsh[1]);
+
+	fcntl(net, F_SETFL, O_NDELAY);
+	fcntl(fromsh[0], F_SETFL, O_NDELAY);
+	signal(SIGPIPE, SIG_IGN);
+
+	idle = 0;
+	for (;;) {
+		int busy = 0;
+		n = read(net, in, sizeof(in));
+		if (n == 0)
+			break;		/* connection closed */
+		if (n > 0) {
+			n = from_net(in, n, buf);
+			if (n && write(tosh[1], buf, n) < 0)
+				break;
+			busy = 1;
+		} else if (errno != EAGAIN)
+			break;
+		n = read(fromsh[0], buf, sizeof(buf));
+		if (n == 0)
+			break;		/* the shell has exited */
+		if (n > 0) {
+			to_net(buf, n);
+			busy = 1;
+		}
+		if (busy)
+			idle = 0;
+		else if (idle < 10)
+			idle++;
+		/* poll quickly while there is traffic, slower when idle */
+		if (!busy)
+			usleep(idle < 10 ? 20000 : 100000);
+	}
+	kill(-shell_pid, SIGHUP);
+	close(tosh[1]);
+	close(fromsh[0]);
+	close(net);
+	while (wait(NULL) > 0)
+		;
+	exit(0);
+}
+
+int main(int argc, char *argv[])
+{
+	struct sockaddr_in addr;
+	int lfd, pid;
+
+	memset(&addr, 0, sizeof(addr));
+	addr.sin_family = AF_INET;
+	addr.sin_port = htons(argc > 1 ? atoi(argv[1]) : 23);
+	lfd = socket(AF_INET, SOCK_STREAM, 0);
+	if (lfd < 0) {
+		perror("telnetd: socket");
+		return 1;
+	}
+	if (bind(lfd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+		perror("telnetd: bind");
+		return 1;
+	}
+	if (listen(lfd, 2) < 0) {
+		perror("telnetd: listen");
+		return 1;
+	}
+	signal(SIGCHLD, SIG_IGN);
+	for (;;) {
+		net = accept(lfd, NULL, NULL);
+		if (net < 0) {
+			if (errno != EINTR)
+				sleep(1);
+			continue;
+		}
+		pid = fork();
+		if (pid == 0) {
+			close(lfd);
+			session();
+		}
+		close(net);
+		/* collect finished sessions */
+		while (waitpid(-1, NULL, WNOHANG) > 0)
+			;
+	}
+}
