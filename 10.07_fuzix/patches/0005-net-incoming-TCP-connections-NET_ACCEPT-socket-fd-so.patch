+/* A connection came in on a listening port: give it a link, and ask the
+   kernel for a socket that accept() will hand out.  -1 if nobody listens
+   or there is no room. */
+static int accept_conn(void)
+{
+	struct netaccept na;
+	int i, lcn, sn;
+
+	for (i = 0; i < NSOCKET; i++)
+		if ((map[i].flags & LINK_LISTEN) && map[i].port == uip_conn->lport)
+			break;
+	if (i == NSOCKET || freeptr == 0)
+		return -1;
+	lcn = get_map();
+	na.listener = map[i].socketn;
+	na.lcn = lcn;
+	na.port = uip_conn->rport;
+	memcpy(&na.addr, &uip_conn->ripaddr, 4);
+	sn = ioctl(knet, NET_ACCEPT, &na);
+	if (sn < 0) {
+		rel_map(lcn);
+		return -1;
+	}
+	map[lcn].socketn = sn;
+	map[lcn].lcn = lcn;
+	map[lcn].conn = uip_conn;
+	uip_conn->appstate = lcn;
+	return 0;
+}
