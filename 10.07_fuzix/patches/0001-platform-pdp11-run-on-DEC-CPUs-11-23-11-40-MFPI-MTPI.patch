diff --git a/Kernel/cpu-pdp11/kernel-pdp11.def b/Kernel/cpu-pdp11/kernel-pdp11.def
index 5610c652b..f91fc1d17 100644
--- a/Kernel/cpu-pdp11/kernel-pdp11.def
+++ b/Kernel/cpu-pdp11/kernel-pdp11.def
@@ -71,3 +71,32 @@
 #define SIGPWR		30
 #define SIGSYS		31
 #define	SIGUNUSED	31
+
+/*
+ * User stack pointer access from kernel mode.
+ *
+ * DEC CPUs with memory management (11/23, 11/34, 11/40, 11/73 ...) read and
+ * write the user mode SP with MFPI SP / MTPI SP, with the PSW's previous
+ * mode set to user.  The Stensat FPGA CPU has no MFPI/MTPI; it maps the
+ * user SP at 177716 instead: build with -DCONFIG_USP_MAPPED for it.
+ *
+ * PUSH_USP pushes the user SP on the kernel stack, POP_USP pops the top of
+ * the kernel stack into the user SP.
+ */
+#ifdef CONFIG_USP_MAPPED
+	.macro PUSH_USP
+	mov	*$0177716,-(sp)
+	.endm
+	.macro POP_USP
+	mov	(sp)+,*$0177716
+	.endm
+#else
+	.macro PUSH_USP
+	bis	$030000,*$0177776	/* previous mode = user */
+	mfpi	sp
+	.endm
+	.macro POP_USP
+	bis	$030000,*$0177776
+	mtpi	sp
+	.endm
+#endif
