   /* 4: /dev/mem etc	System devices (one offs) */
diff --git a/Kernel/platform/platform-pdp11/devtty.c b/Kernel/platform/platform-pdp11/devtty.c
index fdeed35d0..24da46610 100644
--- a/Kernel/platform/platform-pdp11/devtty.c
+++ b/Kernel/platform/platform-pdp11/devtty.c
@@ -25,6 +25,25 @@ static unsigned char tbuf1[TTYSIZ];
 static unsigned char tbuf2[TTYSIZ];
 static uint8_t sleeping;
 
+/* Set by program_vectors: 1 if the second DL11 at 176500 answered */
+extern uint16_t tty2_present;
+/* Set by init_hardware: 1 if the KW11-L register at 177546 answered */
+extern uint16_t kw11_present;
+
+static int tty_absent(uint8_t minor)
+{
+	return minor == 2 && !tty2_present;
+}
+
+int pdp_tty_open(uint_fast8_t minor, uint16_t flag)
+{
+	if (tty_absent(minor)) {
+		udata.u_error = ENODEV;
+		return -1;
+	}
+	return tty_open(minor, flag);
+}
+
 tcflag_t termios_mask[NUM_DEV_TTY + 1] = {
 	0,
 	_CSYS,
@@ -47,6 +66,8 @@ void kputchar(uint_fast8_t c)
 
 ttyready_t tty_writeready(uint8_t minor)
 {
+	if (tty_absent(minor))
+		return TTY_READY_NOW;
 	if (XCSR(minor) & 0x80)
 		return TTY_READY_NOW;
 	return TTY_READY_SOON;
@@ -59,6 +80,8 @@ void tty_putc(uint8_t minor, unsigned char c)
 	   its READY poll in interrupt context (the echo path), so the
 	   pacing has to live here.  READY clears in the same cycle as
 	   the XBUF write, so this spin is race-free. */
+	if (tty_absent(minor))
+		return;
 	while (!(XCSR(minor) & 0x80));
 	XBUF(minor) = c;
 }
@@ -89,7 +112,7 @@ void tty_rx_interrupt(void)
 {
 	uint8_t minor;
 	for (minor = 1; minor <= NUM_DEV_TTY; minor++)
-		while (RCSR(minor) & 0x80)
+		while (!tty_absent(minor) && (RCSR(minor) & 0x80))
 			tty_inproc(minor, RBUF(minor));
 }
 
@@ -98,6 +121,8 @@ void tty_interrupt(void)
 {
 	uint8_t minor;
 	for (minor = 1; minor <= NUM_DEV_TTY; minor++) {
+		if (tty_absent(minor))
+			continue;
 		if ((sleeping & (1 << minor)) && (XCSR(minor) & 0x80)) {
 			tty_outproc(minor);
 			sleeping &= ~(1 << minor);
@@ -112,7 +137,8 @@ void plt_interrupt(void)
 	   with edge-detected pending in trap_ctrl — without this
 	   write the line never falls and only ONE clock interrupt
 	   is ever delivered. */
-	*(volatile uint16_t *)0177546 = 0x40;
+	if (kw11_present)
+		*(volatile uint16_t *)0177546 = 0x40;
 	timer_interrupt();
 	tty_interrupt();
 }
