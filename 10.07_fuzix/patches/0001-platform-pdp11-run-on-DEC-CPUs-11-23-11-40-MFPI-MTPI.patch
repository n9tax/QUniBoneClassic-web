diff --git a/Kernel/platform/platform-pdp11/boot_fuzix_gas.S b/Kernel/platform/platform-pdp11/boot_fuzix_gas.S
new file mode 100644
index 000000000..2fdab7e5d
--- /dev/null
+++ b/Kernel/platform/platform-pdp11/boot_fuzix_gas.S
@@ -0,0 +1,118 @@
+/*
+ * Fuzix RL02 boot block, GNU as version of boot_fuzix.s.
+ *
+ * A DEC RL boot ROM (or SIMH "boot rl0", or the QBone RL loader) reads
+ * the first 512 bytes of the disk to address 0 and starts at 0.  This
+ * code fits in those 512 bytes.  It loads the kernel from RL02 sectors
+ * 4.. (256 bytes each) to address 01000 and jumps there.
+ *
+ * Numbers are octal when they start with 0, decimal otherwise.
+ */
+	.text
+RLCS	= 0174400
+RLBA	= 0174402
+RLDA	= 0174404
+RLMP	= 0174406
+XCSR	= 0177564
+XBUF	= 0177566
+
+KERN_START = 4
+KERN_NSECT = 160		/* 40 KB */
+KERN_ADDR  = 01000
+
+	.globl	start
+start:
+	nop			/* boot block signature */
+	br	boot
+
+	. = start + 040
+boot:
+	mov	$0340, @$0177776
+	mov	$KERN_ADDR, sp
+	mov	$msg, r0
+	jsr	pc, puts
+
+	clr	curcyl
+	mov	$KERN_ADDR, r2		/* destination */
+	mov	$KERN_START, r3		/* linear sector */
+	mov	$KERN_NSECT, r4		/* count */
+
+next:
+	tstb	@$RLCS
+	bpl	next
+	/* cylinder = r3 / 80, r0 = r3 % 80 */
+	mov	r3, r0
+	clr	r5
+1:	cmp	r0, $80
+	blo	2f
+	sub	$80, r0
+	inc	r5
+	br	1b
+2:	cmp	r5, curcyl
+	beq	noseek
+
+	/* seek: difference in bits 15:7, bit 2 = outward */
+	mov	r5, r1
+	sub	curcyl, r1
+	bpl	3f
+	neg	r1
+	ash	$7, r1
+	br	4f
+3:	ash	$7, r1
+	bis	$4, r1
+4:	bis	$1, r1			/* marker bit, as DEC's seek uses */
+	mov	r1, @$RLDA
+	mov	$6, @$RLCS		/* seek */
+5:	tstb	@$RLCS
+	bpl	5b
+	tst	@$RLCS
+	bmi	error
+	mov	r5, curcyl
+
+noseek:
+	clr	r1
+	cmp	r0, $40
+	blo	6f
+	sub	$40, r0
+	bis	$0100, r1		/* head 1 */
+6:	bis	r0, r1
+	mov	r5, r0
+	ash	$7, r0
+	bis	r0, r1
+	mov	r2, @$RLBA
+	mov	r1, @$RLDA
+	mov	$-128, @$RLMP		/* 128 words */
+	mov	$014, @$RLCS		/* read data */
+7:	tstb	@$RLCS
+	bpl	7b
+	tst	@$RLCS
+	bmi	error
+	add	$256, r2
+	inc	r3
+	dec	r4
+	bne	next
+
+	mov	$crlf, r0
+	jsr	pc, puts
+	jmp	@$KERN_ADDR
+
+error:
+	mov	$errmsg, r0
+	jsr	pc, puts
+	halt
+	br	error
+
+puts:
+	tstb	@$XCSR
+	bpl	puts
+	movb	(r0)+, r1
+	beq	1f
+	mov	r1, @$XBUF
+	br	puts
+1:	rts	pc
+
+msg:	.asciz	"\r\nLoading Fuzix..."
+crlf:	.asciz	"\r\n"
+errmsg:	.asciz	"\r\nRL11 error\r\n"
+	.even
+curcyl:	.word	0
