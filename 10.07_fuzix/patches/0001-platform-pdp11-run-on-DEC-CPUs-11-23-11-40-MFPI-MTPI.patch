diff --git a/Kernel/platform/platform-pdp11/init.c b/Kernel/platform/platform-pdp11/init.c
index 3bc4a35c0..2cc0d4103 100644
--- a/Kernel/platform/platform-pdp11/init.c
+++ b/Kernel/platform/platform-pdp11/init.c
@@ -76,12 +76,18 @@ int main(int argc, char **argv)
 	dup(0);				/* fd 1 = stdout */
 	dup(0);				/* fd 2 = stderr */
 
-	for (t = 0; t < NTTY; t++)
-		ttypid[t] = -1;
+	/* A terminal that cannot be opened (no second DL11) is
+	   marked -2 and never gets a shell. */
+	for (t = 0; t < NTTY; t++) {
+		int fd = open(ttydev[t], O_RDWR | O_NOCTTY);
+		ttypid[t] = fd < 0 ? -2 : -1;
+		if (fd >= 0)
+			close(fd);
+	}
 
 	for (;;) {
 		for (t = 0; t < NTTY; t++)
-			if (ttypid[t] < 0)
+			if (ttypid[t] == -1)
 				spawn(t);
 		pid = wait(&status);
 		if (pid < 0)
diff --git a/Kernel/platform/platform-pdp11/main.c b/Kernel/platform/platform-pdp11/main.c
index b6964d671..dc0552a5e 100644
--- a/Kernel/platform/platform-pdp11/main.c
+++ b/Kernel/platform/platform-pdp11/main.c
@@ -84,6 +84,9 @@ void plt_usermmu(void)
  * or 0 if there is nothing to run after all.  Kill paths never
  * return.
  */
+extern uint16_t get_usp(void);
+extern void set_usp(uint16_t);
+
 uint16_t sig_deliver(uint16_t upc, uint16_t upsw, uint16_t ur0, uint16_t ur1)
 {
 	uint_fast8_t sig = udata.u_cursig;
@@ -116,12 +119,12 @@ uint16_t sig_deliver(uint16_t upc, uint16_t upsw, uint16_t ur0, uint16_t ur1)
 	frame[3] = ur0;
 	frame[4] = upc;			/* rtt pops these two */
 	frame[5] = upsw;
-	usp = *(volatile uint16_t *)0177716 - 12;	/* mem-mapped USP */
+	usp = get_usp() - 12;
 	/* uput windows through KIPAR5 and validates the range; a
 	   trashed user SP fails validation and the process dies here
 	   rather than scribbling on the other bank. */
 	if (uput(frame, (void *)usp, 12))
 		doexit(dump_core(SIGKILL));
-	*(volatile uint16_t *)0177716 = usp;
+	set_usp(usp);
 	return (uint16_t)(arg_t)vec;
 }
diff --git a/Kernel/platform/platform-pdp11/pdp11.S b/Kernel/platform/platform-pdp11/pdp11.S
index 708f33cf6..a8733b2df 100644
--- a/Kernel/platform/platform-pdp11/pdp11.S
+++ b/Kernel/platform/platform-pdp11/pdp11.S
@@ -41,12 +41,31 @@ init_hardware:
 	   space each (VA 0x2000-0xCDFF) */
 	mov $128,_ramsize
 	mov $43,_procmem
-	/* KW11-L: enable interrupt, 60Hz line clock, vector 0100, BR6 */
-	mov $0x40,0177546	/* bit 6 = interrupt enable */
+	/* KW11-L: enable interrupt, 60Hz line clock, vector 0100, BR6.
+	   An 11/23 without a KW11-L board has no register at 177546:
+	   its clock interrupt comes from the backplane (BEVENT) and
+	   cannot be switched off.  Probe, and remember the answer. */
+	mov *$4,-(sp)
+	mov *$6,-(sp)
+	mov $kw_nx,*$4
+	mov $0340,*$6
+	mov $1,_kw11_present
+	mov $0x40,*$0177546	/* bit 6 = interrupt enable */
+	mov (sp)+,*$6
+	mov (sp)+,*$4
 	/* DL11: polling mode (RX interrupt disabled until vectors ready) */
 	clr 0177560
 	rts pc
 
+kw_nx:
+	clr _kw11_present
+	rti
+
+	.globl _kw11_present
+	.data
+_kw11_present:	.word 0
+	.text
+
 /*
  * map_init — Set up PDP-11/40 MMU for kernel/user mode separation.
  *
@@ -234,10 +253,25 @@ _program_vectors:
 	   We are still at PSW pri 7 here, so nothing fires until the
 	   kernel drops priority. */
 	mov $0x40,0177560	/* console RCSR bit 6 = IE */
-	mov $0x40,0176500	/* tty2 RCSR bit 6 = IE */
+
+	/* The second DL11 is optional: probe it with the bus error
+	   vector pointing at probe_nx, which clears _tty2_present. */
+	mov $probe_nx,*$4
+	mov $1,_tty2_present
+	mov $0x40,*$0176500	/* tty2 RCSR bit 6 = IE */
+	mov $trap_bus,*$4
 
 	rts pc
 
+probe_nx:
+	clr _tty2_present
+	rti
+
+	.globl _tty2_present
+	.data
+_tty2_present:	.word 0
+	.text
+
 /*
  * Interrupt entry: KW11-L line clock (vector 0100)
  *
@@ -617,7 +651,8 @@ eis_emu:
 	   always worked and this hid until stdio's buffer-size MUL. */
 	bit $0140000,eflags	/* trapped PSW mode bits [15:14] */
 	beq eis_ksp		/* 00 = kernel: R6 was right */
-	mov *$0177716,(r0)	/* user trap: decode reg6 = user SP */
+	PUSH_USP		/* user trap: decode reg6 = user SP */
+	mov (sp)+,(r0)
 eis_ksp:
 
 	/* Fetch faulting opcode (through the user window if needed) */
@@ -753,7 +788,8 @@ eis_ret:
 	   kernel-mode trap esav[6] IS the working SP, mods included. */
 	bit $0140000,eflags
 	beq eis_rk
-	mov esav+12,*$0177716
+	mov esav+12,-(sp)
+	POP_USP
 	mov ksp,sp
 	br eis_rf
 eis_rk:
diff --git a/Kernel/platform/platform-pdp11/tricks.S b/Kernel/platform/platform-pdp11/tricks.S
index 8f958cb74..2def25b99 100644
--- a/Kernel/platform/platform-pdp11/tricks.S
+++ b/Kernel/platform/platform-pdp11/tricks.S
@@ -34,7 +34,7 @@ _plt_switchout:
 	mov r2,-(sp)
 	mov r1,-(sp)
 #ifndef CONFIG_PDP11_04
-	mov *$0177716,-(sp)	/* push user SP (USP reg; no MFPI on this CPU) */
+	PUSH_USP
 #endif
 	mov sp,_udata+U_DATA__U_SP
 
@@ -72,7 +72,7 @@ _preempt_switchout:
 	mov r2,-(sp)
 	mov r1,-(sp)
 #ifndef CONFIG_PDP11_04
-	mov *$0177716,-(sp)	/* user SP (memory-mapped USP) */
+	PUSH_USP
 #endif
 	mov sp,_udata+U_DATA__U_SP
 
@@ -181,7 +181,7 @@ owned:
 	clr _runticks
 	mov _udata+U_DATA__U_SP,sp
 #ifndef CONFIG_PDP11_04
-	mov (sp)+,*$0177716	/* pop user SP (USP reg; no MTPI on this CPU) */
+	POP_USP
 #endif
 	mov (sp)+,r1
 	mov (sp)+,r2
@@ -219,7 +219,7 @@ _dofork:
 	mov r2,-(sp)
 	mov r1,-(sp)
 #ifndef CONFIG_PDP11_04
-	mov *$0177716,-(sp)	/* push user SP (USP reg; no MFPI on this CPU) */
+	PUSH_USP
 #endif
 	mov sp,_udata+U_DATA__U_SP
 
@@ -375,3 +375,15 @@ badswitchmsg:
 	   safe headroom now. */
 	.= .+512
 swapstack:
+
+/* uint16_t get_usp(void), void set_usp(uint16_t): the user mode SP */
+	.globl _get_usp
+	.globl _set_usp
+_get_usp:
+	PUSH_USP
+	mov (sp)+,r0
+	rts pc
+_set_usp:
+	mov 2(sp),-(sp)
+	POP_USP
+	rts pc
