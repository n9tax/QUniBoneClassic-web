+/* kill -USR1 netd: show the links (for debugging) */
+static volatile uint8_t want_dump;
+static void dump_sig(int sig)
+{
+	want_dump = 1;
+	signal(SIGUSR1, dump_sig);
+}
+
+static void dump_links(void)
+{
+	int i;
+	fprintf(stderr, "netd: %d free links:", freeptr);
+	for (i = 0; i < freeptr; i++)
+		fprintf(stderr, " %d", freelist[i]);
+	fprintf(stderr, "\n");
+	for (i = 0; i < NSOCKET; i++)
+		fprintf(stderr, " link %d: flags %x sock %d conn %d port %u t %u-%u r %u-%u\n",
+			i, map[i].flags, map[i].socketn,
+			map[i].conn ? (int)(map[i].conn - uip_conns) : -1,
+			UIP_HTONS(map[i].port), map[i].tstart, map[i].tend,
+			map[i].rstart, map[i].rend);
+	for (i = 0; i < UIP_CONNS; i++)
+		if (uip_conns[i].tcpstateflags != UIP_CLOSED)
+			fprintf(stderr, " tcp %d: state %d app %d lport %u\n", i,
+				uip_conns[i].tcpstateflags & UIP_TS_MASK,
+				uip_conns[i].appstate, UIP_HTONS(uip_conns[i].lport));
+	for (i = 0; i < UIP_UDP_CONNS; i++)
+		if (uip_udp_conns[i].lport)
+			fprintf(stderr, " udp %d: app %d lport %u\n", i,
+				uip_udp_conns[i].appstate, UIP_HTONS(uip_udp_conns[i].lport));
+}
