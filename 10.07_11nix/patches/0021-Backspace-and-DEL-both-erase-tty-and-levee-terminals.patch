 		}
-		if (c == t->termios.c_cc[VERASE]) {
+		/* Backspace and DEL both erase while the erase key is
+		   either of them: terminals send one or the other */
+		wr = t->termios.c_cc[VERASE];
+		if (c == wr || ((c == CTRL('H') || c == 0x7F) &&
+				(wr == CTRL('H') || wr == 0x7F))) {
 		        wr = ECHOE;
 		        goto eraseout;
 		} else if (c == t->termios.c_cc[VKILL]) {
