diff --git a/Applications/levee/unixcall.c b/Applications/levee/unixcall.c
index 677682532..478040439 100644
--- a/Applications/levee/unixcall.c
+++ b/Applications/levee/unixcall.c
@@ -60,7 +60,7 @@ char *basename(char *s)
 
 
 static int ioset = 0;
-static struct termios old;
+static struct termios old, raw;
 
 void initcon(void)
 {
@@ -79,6 +79,7 @@ void initcon(void)
 	new.c_oflag = 0;
 
 	tcsetattr(0, TCSANOW, &new);	/* terminal setup for editor */
+	memcpy(&raw, &new, sizeof(raw));
         ioset=1;
     }
 }
@@ -91,10 +92,71 @@ void fixcon(void)
     }
 }
 
+/* Arrow keys: a terminal sends ESC [ A (or ESC O A) all at once; a lone
+   ESC is followed by nothing for a while.  The arrows move like k j l h;
+   in insert mode they end the insert first (ESC, then the move), on the
+   : and / line they are ignored. */
+int in_line;			/* 1 insert mode, 2 the : or / line */
+static int pending = -1;	/* a key read too early */
+
+static int key_timed(void)
+{
+    unsigned char c;
+    return read(0, &c, 1) == 1 ? c : -1;
+}
+
+/* after an ESC: h j k l for an arrow, 0 for another sequence, -1 for none */
+static int arrow(void)
+{
+    int c, k = -1;
+
+    raw.c_cc[VMIN] = 0;
+    raw.c_cc[VTIME] = 1;
+    tcsetattr(0, TCSANOW, &raw);
+    c = key_timed();
+    if (c == '[' || c == 'O') {
+	do
+	    c = key_timed();
+	while (c >= 0 && c < 0x40);	/* parameters, as in ESC [ 2 ~ */
+	switch (c) {
+	case 'A': k = 'k'; break;
+	case 'B': k = 'j'; break;
+	case 'C': k = 'l'; break;
+	case 'D': k = 'h'; break;
+	default:  k = 0;
+	}
+    }
+    else
+	pending = c;		/* a key typed right after ESC, or none */
+    raw.c_cc[VMIN] = old.c_cc[VMIN];
+    raw.c_cc[VTIME] = old.c_cc[VTIME];
+    tcsetattr(0, TCSANOW, &raw);
+    return k;
+}
+
 int getKey(void)
 {
     unsigned char c;
+    int k;
 
-    read(0,&c,1);
-    return c;
+    if (pending >= 0) {
+	k = pending;
+	pending = -1;
+	return k;
+    }
+    for (;;) {
+	read(0,&c,1);
+	if (c != 033 || !ioset)
+	    return c;
+	k = arrow();
+	if (k < 0)
+	    return 033;		/* the ESC key itself */
+	if (k == 0 || in_line == 2)
+	    continue;		/* ignored */
+	if (in_line == 1) {
+	    pending = k;	/* end the insert, then move */
+	    return 033;
+	}
+	return k;
+    }
 }
diff --git a/Kernel/tty.c b/Kernel/tty.c
index fb53b5968..4d3461a58 100644
--- a/Kernel/tty.c
+++ b/Kernel/tty.c
@@ -450,7 +450,11 @@ sigout:
