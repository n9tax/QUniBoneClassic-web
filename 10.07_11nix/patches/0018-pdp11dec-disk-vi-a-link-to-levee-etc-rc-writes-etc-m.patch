From ba37f7149edb6af7f9a419f39e2f8b58923ccfdb Mon Sep 17 00:00:00 2001
From: Joe <joe@n9tax.com>
Date: Thu, 12 Nov 2026 19:52:03 -0600
Subject: [PATCH] pdp11dec disk: vi (a link to levee); /etc/rc writes /etc/mtab
 rw when the root fs is writable and warns at boot when it is read-only

---
 .../platform/platform-pdp11dec/build_fuzix_disk.sh | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh b/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh
index e22c807b3..2cfb75bde 100755
--- a/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh
+++ b/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh
@@ -248,6 +248,15 @@ RESEOF
 # /etc/rc: run by init at boot
 cat > "$BUILDDIR/rc" <<'RCEOF'
 # /etc/rc - run once by init at boot, before the login shells.
+# The root file system: read-write, unless the kernel found it dirty.
+# /etc/mtab says "ro" until it can be written (for mount and df).
+if (echo "/dev/hd0 / fuzix rw 0 0" > /etc/mtab) 2> /dev/null
+then
+	:
+else
+	echo "WARNING: the disk is READ-ONLY (not synced before the last stop)."
+	echo "Repair it: fsck /dev/hd0, answer y, then START and 10000g."
+fi
 # The network: netd -d returns once the DELQA is running.
 if netd -d
 then
@@ -313,8 +322,8 @@ $TOOLDIR/mkfs "$FSIMG" $FS_INODES $FS_BLOCKS
 # Populate with minimal device nodes and directories
 echo "Populating filesystem..."
 # --- Root /etc files ---
-# Static: the root fs is mounted ro, so mount can never rewrite mtab;
-# a canned copy describing the root mount is exactly right.  passwd
+# mtab: the root mount; /etc/rc rewrites it "rw" when the root fs is
+# writable (the kernel mounts it ro when it was not cleanly stopped).  passwd
 # gives whoami/getpwuid something to answer with; liberror.txt gives
 # strerror its message table.
 cat > "$BUILDDIR/passwd" <<'PWEOF'
@@ -451,6 +460,7 @@ bget $BUILDDIR/sigtest.fuz sigtest
 chmod 755 sigtest
 bget $BUILDDIR/levee.fuz levee
 chmod 755 levee
+ln levee vi
 $(for b in $EXTRA_BINS; do echo "bget $BUILDDIR/$b.fuz $b"; echo "chmod 755 $b"; done)
 ln cp mv
 ln cp ln
-- 
