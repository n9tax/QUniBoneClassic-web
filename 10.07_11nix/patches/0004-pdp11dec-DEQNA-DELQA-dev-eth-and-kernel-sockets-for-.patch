diff --git a/Kernel/platform/platform-pdp11dec/tricks.S b/Kernel/platform/platform-pdp11dec/tricks.S
index 1c21d2d30..db0a9f3a9 100644
--- a/Kernel/platform/platform-pdp11dec/tricks.S
+++ b/Kernel/platform/platform-pdp11dec/tricks.S
@@ -335,6 +335,20 @@ bank_copy:
 	sob r5,1b
 	rts pc
 
+/*
+ * uint16_t io_present(uint16_t addr): 1 if a device register answers
+ * at addr (I/O page), with the bus error vector caught.
+ */
+	.globl _io_present
+_io_present:
+	mov *$4,-(sp)
+	mov *$6,-(sp)
+	mov $pp_nx,*$4
+	mov $0340,*$6
+	mov $1,r0
+	tst *6(sp)
+	br pp_out
