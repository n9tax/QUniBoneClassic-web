diff --git a/Kernel/platform/platform-pdp11dec/dev_qe.c b/Kernel/platform/platform-pdp11dec/dev_qe.c
new file mode 100644
index 000000000..67e43a537
--- /dev/null
+++ b/Kernel/platform/platform-pdp11dec/dev_qe.c
@@ -0,0 +1,275 @@
+/*
+ * DEQNA / DELQA Ethernet controller at 174440: /dev/eth for netd.
+ *
+ * read() returns one received frame (0 if none is waiting: netd polls),
+ * write() sends one frame, ioctl 0 returns the Ethernet address.
+ *
+ * The controller works through lists of six word buffer descriptors
+ * (DMA).  It is used in DEQNA-lock mode, as DEC's drivers do:
+ *
+ * receive:  NRX descriptors, each with a buffer for a whole frame, then
+ *           an invalid one that ends the list.  When the controller has
+ *           filled them all it stops there (CSR RL, "receive list
+ *           invalid"); the list is then re-armed and handed over again.
+ * transmit: one descriptor and an end marker per frame; write() waits
+ *           until the controller has taken it (status word 1 written).
+ *
+ * The descriptors are in kernel data (identity mapped, so their virtual
+ * address is physical).  The frame buffers are physical memory above the
+ * user banks (qe_click, main.c), reached through the KIPAR6 window.
+ */
+#include <kernel.h>
+#include <kdata.h>
+#include <printf.h>
+#include <dev_qe.h>
+
+#define QE_BASE		0174440
+#define QE_REG(n)	(*(volatile uint16_t *)(QE_BASE + 2 * (n)))
+#define QE_RBDL_LO	QE_REG(2)
+#define QE_RBDL_HI	QE_REG(3)
+#define QE_TBDL_LO	QE_REG(4)
+#define QE_TBDL_HI	QE_REG(5)
+#define QE_VAR		QE_REG(6)
+#define QE_CSR		QE_REG(7)
+
+#define CSR_RE	0000001
+#define CSR_SR	0000002
+#define CSR_NI	0000004
+#define CSR_XL	0000020
+#define CSR_RL	0000040
+#define CSR_IL	0000400
+
+#define DSC_V	0100000		/* valid */
+#define DSC_C	0040000		/* chain */
+#define DSC_E	0020000		/* end of message */
+#define DSC_S	0010000		/* setup frame */
+#define DSC_L	0000200		/* odd length: last byte unused */
+
+#define SW1_NOTYET	0100000
+#define SW1_LASTNOT	0140000
+#define SW1_ERROR	0040000
+#define SW1_ESETUP	0020000
+
+#define ETH_MAX		1514
+#define BUFW		760		/* words per buffer: 1520 bytes */
+#define BUFCLICKS	24		/* 1536 bytes */
+#define NRX		8
+
+#define KIPAR6	(*(volatile uint16_t *)0172354)
+#define WINDOW	((uint8_t *)0xC000)
+
+struct desc {
+	uint16_t flag, addr_hi, addr_lo, wc, sw1, sw2;
+};
+
+static volatile struct desc rxd[NRX + 1];
+static volatile struct desc txd[2];
+static uint8_t rx_next;
+static uint8_t need_reload;
+static uint8_t qe_state;	/* 0 not tried, 1 running, 2 absent */
+static uint8_t mac[6];
+
+/* Physical memory for the buffers: NRX receive, one transmit */
+extern uint16_t qe_click;
+#define RXCLICK(i)	(qe_click + (i) * BUFCLICKS)
+#define TXCLICK		(qe_click + NRX * BUFCLICKS)
+
+extern uint16_t io_present(uint16_t addr);
+
+static uint8_t *window(uint16_t click)
+{
+	KIPAR6 = click;
+	return WINDOW;
+}
+
+/* Point a descriptor at a buffer: 18 bit physical address */
+static void set_buf(volatile struct desc *d, uint16_t click, uint16_t flags)
+{
+	d->addr_lo = click << 6;
+	d->addr_hi = flags | (click >> 10);
+}
+
+static void rx_arm(void)
+{
+	uint8_t i;
+	for (i = 0; i < NRX; i++) {
+		rxd[i].flag = SW1_NOTYET;
+		set_buf(&rxd[i], RXCLICK(i), DSC_V);
+		rxd[i].wc = -BUFW;
+		rxd[i].sw1 = SW1_NOTYET;
+		rxd[i].sw2 = 0;
+	}
+	rxd[NRX].flag = SW1_NOTYET;
+	rxd[NRX].addr_hi = 0;		/* end of the list */
+	rxd[NRX].sw1 = SW1_NOTYET;
+	rx_next = 0;
+}
+
+static void rx_load(void)
+{
+	QE_RBDL_LO = (uint16_t)rxd;
+	QE_RBDL_HI = 0;
+}
+
+/* Send the transmit buffer; 0 on error or timeout */
+static int tx_buffer(uint16_t len, uint16_t setup)
+{
+	uint16_t words = (len + 1) >> 1;
+	uint16_t n;
+
+	txd[0].flag = SW1_NOTYET;
+	set_buf(&txd[0], TXCLICK, DSC_V | DSC_E | setup | ((len & 1) ? DSC_L : 0));
+	txd[0].wc = -words;
+	txd[0].sw1 = SW1_NOTYET;
+	txd[0].sw2 = 0;
+	txd[1].flag = SW1_NOTYET;
+	txd[1].addr_hi = 0;
+	txd[1].sw1 = SW1_NOTYET;
+	QE_TBDL_LO = (uint16_t)txd;
+	QE_TBDL_HI = 0;
+	/* A frame takes about a millisecond on the wire */
+	for (n = 0; n < 60000U; n++) {
+		if (txd[0].sw1 != SW1_NOTYET)
+			return (txd[0].sw1 & SW1_LASTNOT) != SW1_ERROR;
+		if (QE_CSR & CSR_NI) {
+			kprintf("qe: nonexistent memory\n");
+			return 0;
+		}
+	}
+	return 0;
+}
+
+/* Receive broadcasts and our own address */
+static void setup_frame(void)
+{
+	uint8_t *p = window(TXCLICK);
+	uint8_t n, j;
+	memset(p, 0, 128);
+	for (n = 0; n < 14; n++) {
+		uint8_t base = n < 7 ? n + 1 : 64 + n - 7 + 1;
+		for (j = 0; j < 6; j++)
+			p[base + j * 8] = n == 0 ? 0xFF : mac[j];
+	}
+	tx_buffer(128, DSC_S);
+}
+
+static int qe_start(void)
+{
+	uint8_t i;
+	uint16_t n;
+
+	if (qe_state)
+		return qe_state == 1;
+	qe_state = 2;
+	if (!qe_click || !io_present(QE_BASE + 016))
+		return 0;
+	QE_CSR = CSR_SR;		/* software reset on 1 -> 0 */
+	QE_CSR = 0;
+	for (n = 0; n < 20000U; n++)	/* let it settle */
+		;
+	QE_VAR = 0;			/* DEQNA-lock mode, no interrupts */
+	for (i = 0; i < 6; i++)
+		mac[i] = QE_REG(i) & 0xFF;
+	QE_CSR = CSR_IL;		/* receiver off while loading */
+	rx_arm();
+	rx_load();
+	QE_CSR = CSR_IL | CSR_RE;
+	setup_frame();
+	qe_state = 1;
+	kprintf("qe0: DEQNA/DELQA at 174440, %x:%x:%x:%x:%x:%x\n",
+		mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+	return 1;
+}
+
+int eth_open(uint8_t minor, uint16_t flag)
+{
+	used(flag);
+	if (minor || !qe_start()) {
+		udata.u_error = ENODEV;
+		return -1;
+	}
+	return 0;
+}
+
+int eth_close(uint8_t minor)
+{
+	used(minor);
+	return 0;
+}
+
+/* One frame, or 0 if none is waiting */
+int eth_read(uint8_t minor, uint8_t rawflag, uint8_t flag)
+{
+	int r = 0;
+	used(minor);
+	used(rawflag);
+	used(flag);
+
+	while (rx_next < NRX) {
+		volatile struct desc *d = &rxd[rx_next];
+		uint16_t sw1 = d->sw1;
+		if (sw1 == SW1_NOTYET)
+			break;
+		if (!(sw1 & SW1_ERROR) && !(sw1 & SW1_ESETUP)) {
+			uint16_t len = ((sw1 & 03400) | (d->sw2 & 0377)) + 60;
+			if (len > ETH_MAX)
+				len = ETH_MAX;
+			if (len > udata.u_count)
+				len = udata.u_count;
+			if (uput(window(RXCLICK(rx_next)), udata.u_base, len))
+				r = -1;
+			else
+				r = len;
+		}
+		/* errors, setup frame echoes, pieces of chained frames:
+		   dropped */
+		rx_next++;
+		if (r)
+			break;
+	}
+	if (rx_next >= NRX) {
+		rx_arm();
+		need_reload = 1;
+	}
+	/* The controller stops at the end of the list: hand it over again */
+	if (need_reload && (QE_CSR & CSR_RL)) {
+		need_reload = 0;
+		rx_load();
+	}
+	return r;
+}
+
+int eth_write(uint8_t minor, uint8_t rawflag, uint8_t flag)
+{
+	uint16_t len = udata.u_count;
+	uint8_t *p;
+	used(minor);
+	used(rawflag);
+	used(flag);
+
+	if (len > ETH_MAX) {
+		udata.u_error = EMSGSIZE;
+		return -1;
+	}
+	p = window(TXCLICK);
+	if (uget(udata.u_base, p, len))
+		return -1;
+	if (len < 60) {
+		memset(p + len, 0, 60 - len);
+		len = 60;
+	}
+	if (!tx_buffer(len, 0)) {
+		udata.u_error = EIO;
+		return -1;
+	}
+	return udata.u_count;
+}
+
+/* ioctl 0: the Ethernet address (6 bytes) */
+int eth_ioctl(uint8_t minor, uarg_t request, char *data)
+{
+	used(minor);
+	if (request != 0)
+		return -1;
+	return uput(mac, data, 6);
+}
