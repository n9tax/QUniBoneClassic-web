diff --git a/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh b/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh
index 8c5e0df41..a4f4e423d 100755
--- a/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh
+++ b/Kernel/platform/platform-pdp11dec/build_fuzix_disk.sh
@@ -206,6 +206,42 @@ build_util levee \
 CFLAGS="$SAVED_CFLAGS"
 make_fuz levee
 
+# --- Networking: netd (uIP) on /dev/eth, and its programs ---
+NETDIR="$FUZIXDIR/Applications/netd"
+echo "Building netd and network programs..."
+SAVED_CFLAGS="$CFLAGS"
+CFLAGS="$CFLAGS -DNETD_LITTLE_ENDIAN -I$NETDIR"
+build_util netd $(for f in netd uip uiplib timer clock-arch uip_arp eth; do echo "$NETDIR/$f.c"; done)
+make_fuz netd
+NET_BINS="netd"
+for app in telnet ping ntpdate htget dig; do
+    build_util $app "$NETDIR/$app.c" "$NETDIR/gethostbyname.c"
+    make_fuz $app
+    NET_BINS="$NET_BINS $app"
+done
+for app in httpd ifconfig echoping; do
+    build_util $app "$NETDIR/$app.c"
+    make_fuz $app
+    NET_BINS="$NET_BINS $app"
+done
+build_util tinyirc "$NETDIR/tinyirc.c" "$NETDIR/linein.c" "$NETDIR/gethostbyname.c"
+make_fuz tinyirc
+NET_BINS="$NET_BINS tinyirc"
+CFLAGS="$SAVED_CFLAGS"
+EXTRA_BINS="$EXTRA_BINS $NET_BINS"
+
+# /etc/netrc: SIMH's NAT network by default; edit for your LAN
+cat > "$BUILDDIR/netrc" <<'NETEOF'
+# netd configuration: this machine's address on the LAN.
+# Edit to suit, then restart netd.
+ipaddr  10.0.2.15
+gateway 10.0.2.2
+netmask 255.255.255.0
+NETEOF
+cat > "$BUILDDIR/resolv.conf" <<'RESEOF'
+nameserver 10.0.2.3
+RESEOF
+
 # --- Assemble bootloader ---
 echo "Assembling bootloader..."
 PDP11_ASM="${PDP11_ASM:-pdp11_asm.py}"
@@ -288,6 +324,8 @@ mknod zero 020666 1029
 mknod proc 020666 1025
 mknod hd0 060660 0
 mknod hd1 060660 1
+mknod eth 020666 2048
+mknod net 020666 1089
 cd /
 mkdir tmp
 mkdir home
@@ -402,6 +440,10 @@ bget $BUILDDIR/group group
 chmod 644 group
 bget $BUILDDIR/mtab mtab
 chmod 644 mtab
+bget $BUILDDIR/netrc netrc
+chmod 644 netrc
+bget $BUILDDIR/resolv.conf resolv.conf
+chmod 644 resolv.conf
 cd /usr
 mkdir lib
 chmod 755 lib
